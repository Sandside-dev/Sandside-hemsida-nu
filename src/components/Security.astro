---
// Punkterna bygger på affärsplanen (tekniska lösningar och hållbarhet).
// Lägg inte till något här som ni inte kan stå för, t.ex. avtal ni inte har än.
const items = [
  { title: 'Ni äger er bot', text: 'Chattbotten installeras i ert eget konto. Era data och ert avtal med leverantören är era.' },
  { title: 'Data inom EU', text: 'Chatbottens flöden och data ligger hos n8n i Frankfurt.' },
  { title: 'Ärlig AI', text: 'Botten säger alltid att den är en AI, och den svarar bara utifrån er egen information.' },
  { title: 'Bara det som behövs', text: 'Vi samlar bara in de uppgifter chatbotten behöver och bygger med testdata och tillfällig åtkomst.' },
  { title: 'Människa när det behövs', text: 'Frågor som botten inte kan svara på hänvisas vidare till er personal.' },
];
---

<section id="sakerhet" class="border-t border-line py-24 md:py-36">
  <div class="wrap grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="label label-line" data-scramble>/ Säkerhet</p>
      <h2 class="display mt-1 text-[44px] sm:text-6xl lg:text-[76px]">Era kunders uppgifter är era</h2>
      <p class="mt-6 max-w-[40ch] text-[17px] leading-relaxed text-ink/75" data-reveal>
        Era kunder delar namn, nummer och ibland känsliga saker. Så här tar vi hand om det.
      </p>
    </div>

    <ol class="md:col-span-7 md:pt-8">
      {
        items.map((it, i) => (
          <li class="group grid grid-cols-[52px_1fr] gap-x-4 border-t border-line py-6 last:border-b md:grid-cols-[72px_220px_1fr] md:py-7" data-reveal style={`--d:${i * 60}ms`}>
            <span class="font-mono text-[13px] text-muted transition-colors group-hover:text-sun">/{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-mono text-[14px] font-medium uppercase tracking-[0.03em]">{it.title}</h3>
            <p class="col-start-2 mt-2 text-[16px] leading-relaxed text-ink/70 md:col-start-3 md:mt-0">{it.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
