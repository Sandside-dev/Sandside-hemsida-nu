---
// Punkterna bygger på affärsplanen (tekniska lösningar och hållbarhet).
// Lägg inte till något här som ni inte kan stå för, t.ex. avtal ni inte har än.
const items = [
  { title: 'Ni äger er bot', text: 'Chattbotten installeras i ert eget konto. Era data och ert avtal med leverantören är era.' },
  { title: 'Data inom EU', text: 'Flöden och data ligger hos n8n i Frankfurt, och hemsidorna hos webbhotell inom EU.' },
  { title: 'Ärlig AI', text: 'Botten säger alltid att den är en AI, och den svarar bara utifrån er egen information.' },
  { title: 'Bara det som behövs', text: 'Vi samlar bara in de uppgifter lösningen behöver och bygger med testdata och tillfällig åtkomst.' },
  { title: 'Inga låsningar', text: 'Vi bygger med vanliga verktyg som n8n och WordPress, så en annan utvecklare kan ta över om det behövs.' },
  { title: 'En människa när det behövs', text: 'Frågor som botten inte kan svara på skickas vidare till er personal.' },
];
---

<section id="sakerhet" class="section">
  <div class="wrap">
    <div class="max-w-[640px]">
      <h2 class="h2">Så hanterar vi era kunders uppgifter</h2>
      <p class="lead mt-5">Era kunder delar namn, nummer och ibland känsliga saker. Det här gäller för allt vi bygger.</p>
    </div>
    <dl class="mt-14 grid gap-x-10 border-t border-line sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((it, i) => (
          <div class="border-b border-line py-7" data-reveal style={`--d:${(i % 3) * 70}ms`}>
            <dt class="h3">{it.title}</dt>
            <dd class="mt-2 text-[16px] text-ink/70">{it.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
