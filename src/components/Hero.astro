---
import Button from './Button.astro';
import ChatDemo from './ChatDemo.astro';
import { plans, site } from '../data/site';
const price = plans.find((p) => p.id === 'chattbot')?.price?.toLocaleString('sv-SE');
---

<section id="top" class="relative overflow-hidden pb-0 pt-28 md:pt-36">
  <div class="wrap grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-6 lg:pb-24">
      <p class="eyebrow">{site.legalName} · {site.city}</p>
      <h1 class="h1 mt-5 max-w-[15ch]">En chattbot som svarar era kunder medan ni jobbar</h1>
      <p class="lead mt-6 max-w-[46ch]">
        Vi bygger den åt er, tränad på era priser, öppettider och vanliga frågor. Den svarar dygnet runt och
        skickar det den inte kan svara på vidare till er.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
        <Button href="#boka">Boka ett möte</Button>
        <Button href="#priser" variant="text">{price} kr, en gång</Button>
      </div>
    </div>

    <div class="relative min-w-0 lg:col-span-6">
      <!-- Solen som går ned bakom horisonten -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div
          data-sun
          class="absolute bottom-[-50%] left-1/2 aspect-square w-[120%] -translate-x-1/2 rounded-full bg-sun transition-transform duration-[1600ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] md:w-[104%]"
        ></div>
      </div>
      <div class="relative px-3 pb-10 pt-6 sm:px-10 md:pb-14">
        <ChatDemo />
      </div>
    </div>
  </div>
  <div class="h-px bg-ink/10"></div>
</section>

<script>
  // Solen glider upp en bit när sidan laddas
  const sun = document.querySelector<HTMLElement>('[data-sun]');
  if (sun && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    sun.style.transform = 'translate(-50%, 14%)';
    requestAnimationFrame(() => requestAnimationFrame(() => (sun.style.transform = 'translate(-50%, 0)')));
  }
</script>
