<!-- BAKGRUND: bg-ink (marinblå) och vit text (#ffffff). Tidigare: bg-sand med mörk text (text-ink, brödtext text-ink/80), punkten efter Sandside var krämvit (#f4efe3), tidigare orange. -->
<section id="top" class="cut-br relative overflow-hidden bg-ink pb-8 pt-20 [--cut:48px] md:pb-10 md:pt-24 md:[--cut:96px]">
  <!-- SANDSIDE.-texten flyttad hit från sidfoten (Footer.astro). -->
  <div class="relative select-none">
    <h1 class="wrap whitespace-nowrap text-[23vw] font-bold leading-[0.78] tracking-[-0.07em] text-[#ffffff] md:text-[21.5vw] xl:text-[270px]">
      Sandside<span class="ml-[0.04em] inline-block size-[0.16em] rounded-full bg-[#ffffff] align-baseline" aria-hidden="true"></span>
    </h1>
  </div>

  <!-- Rubriken "En chatbot som svarar på er hemsida." är borttagen. SANDSIDE.-texten är nu sidans h1. -->
  <!-- 3D-bollen och vågorna är borttagna härifrån (koden finns kvar i src/scripts/hero3d.ts; canvas: <canvas data-hero-3d> + script som anropar initHero). -->
  <!-- LAYOUT: rubrik överst, brödtext till vänster och boll till höger. Förra layouten: boll till vänster och text till höger (kolumnerna hade bytt plats). -->
  <div class="wrap">
    <div class="mt-6 grid items-center gap-4 md:mt-4 md:grid-cols-12 md:gap-8">
      <div class="pb-2 md:col-span-6 md:pt-6">
        <p class="max-w-[46ch] text-[17px] leading-relaxed text-[#ffffff]/75 md:text-lg">
          Sandside bygger chatbotar för företags hemsidor. Chatbotten svarar på återkommande kundfrågor om till
          exempel öppettider, tjänster och hur man bokar, även när ni inte har tid att svara själva.
        </p>
      </div>
    </div>
  </div>
</section>
