---
import Button from './Button.astro';
import { industries } from '../data/site';

// Enkla linjeikoner för branscherna i remsan
const icons: Record<string, string> = {
  Trafikskolor:
    '<path d="M5 16.5h14M6.5 16.5V19M17.5 16.5V19M4.5 16.5l1.6-5.2A2 2 0 0 1 8 9.9h8a2 2 0 0 1 1.9 1.4l1.6 5.2"/><circle cx="8" cy="14" r=".9"/><circle cx="16" cy="14" r=".9"/>',
  Frisörer:
    '<circle cx="6.5" cy="17" r="2.5"/><circle cx="17.5" cy="17" r="2.5"/><path d="M8.3 15.3 18 5M15.7 15.3 6 5"/>',
  Tatuerare: '<path d="m14 4 6 6M16 6 7.5 14.5 6 18l3.5-1.5L18 8M4 20l2-2"/>',
  'PT och gym': '<path d="M6 8v8M18 8v8M3.5 10v4M20.5 10v4M6 12h12"/>',
  Hantverkare: '<path d="m14.5 6.5 3 3M4 20l8.5-8.5M13 4.5l2.5-1 5 5-1 2.5-3-.5-3.5-3.5z"/>',
};
const strip = [...industries, ...industries];
---

<section id="top" class="cut-br relative overflow-hidden bg-surface pb-14 pt-[104px] [--cut:48px] md:pb-[92px] md:pt-[120px] md:[--cut:84px]">
  <div class="wrap">
    <h1 class="h1" data-reveal>
      En chattbot som svarar<br class="hidden sm:inline" /> era kunder dygnet runt.
    </h1>

    <div class="grid items-center md:mt-2 md:grid-cols-2 md:gap-6 lg:-mt-2">
      <!-- 3D-loggan -->
      <div class="relative -mx-5 md:mx-0 md:-ml-8 lg:-ml-12">
        <div class="relative mx-auto aspect-[1/0.84] w-full max-w-[420px] md:aspect-[1/0.92] md:max-w-[620px]">
          <canvas
            data-logo-3d
            data-scroll-tilt
            aria-hidden="true"
            class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000 [&.is-ready]:opacity-100"
          ></canvas>
        </div>
      </div>

      <div class="min-w-0 md:pt-8">
        <p class="lead max-w-[595px]" data-reveal style="--d:120ms">
          Sandside bygger chattbottar åt små företag. Botten tränas på er egen information, svarar kunderna på
          några sekunder och skickar vidare till er när en människa behövs.
        </p>

        <div class="mt-8 grid gap-2 sm:grid-cols-2 md:mt-9 md:grid-cols-1 xl:grid-cols-2" data-reveal style="--d:220ms">
          <Button href="#boka" class="w-full">Boka kostnadsfri demo</Button>
          <Button variant="light" class="w-full" data-open-chat>Testa chattbotten</Button>
        </div>

        <div class="mt-10 md:mt-14" data-reveal style="--d:320ms">
          <div class="rule"></div>
          <div class="marquee-wrap fade-x mt-6 overflow-hidden" aria-label="Branscher vi bygger chattbottar för" role="region">
            <ul class="marquee">
              {
                strip.map((name, i) => (
                  <li
                    class="flex shrink-0 items-center gap-2.5 pr-12 text-[19px] font-bold tracking-[-0.03em] text-[#6f6f6f]"
                    aria-hidden={i >= industries.length ? 'true' : undefined}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      class="size-[26px]"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={icons[name] ?? ''}
                    />
                    {name}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // 3D laddas separat, så att text och knappar syns direkt
  const canvas = document.querySelector<HTMLCanvasElement>('[data-logo-3d][data-scroll-tilt]');
  if (canvas) import('../scripts/logo3d').then((m) => m.initLogo3D(canvas, { scrollTilt: true }));
</script>
