---
// Kalkylator: vad kostar återkommande frågor i dag, och när är chattbotten betald?
// Bygger på räkneexemplet i affärsplanen (frisör, 30 min/dag, 300 kr/timme).
import { plans } from '../data/site';
const price = plans.find((p) => p.id === 'chattbot')?.price ?? 8000;

const inputs = [
  { id: 'fragor', label: 'Frågor per dag', min: 2, max: 40, step: 1, value: 10, unit: 'st' },
  { id: 'minuter', label: 'Minuter per fråga', min: 1, max: 10, step: 1, value: 3, unit: 'min' },
  { id: 'timpris', label: 'Vad en timme av er tid är värd', min: 200, max: 800, step: 50, value: 300, unit: 'kr' },
  { id: 'andel', label: 'Andel frågor botten klarar själv', min: 30, max: 90, step: 10, value: 70, unit: '%' },
];
---

<section id="kalkyl" class="section border-t border-line">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16 [&>*]:min-w-0">
    <div class="lg:col-span-5">
      <h2 class="h2">Vad kostar frågorna er i dag?</h2>
      <p class="lead mt-5">
        Räkna på er egen vardag. Från början står ett exempel: en frisör som lägger en halvtimme om dagen på samma
        frågor.
      </p>
      <p class="mt-6 text-[14px] text-muted">
        Räknat på 20 arbetsdagar i månaden. Hur många frågor botten klarar beror på era kunder. Det går vi igenom på
        första mötet.
      </p>
    </div>

    <div class="grid gap-5 rounded-[20px] border border-line p-6 md:grid-cols-2 md:p-8 lg:col-span-7" data-calc data-price={price}>
      <div class="space-y-7">
        {
          inputs.map((i) => (
            <label class="block">
              <span class="flex items-baseline justify-between gap-3 text-[15px]">
                <span class="text-ink/75">{i.label}</span>
                <span class="font-semibold tabular-nums">
                  <output data-out={i.id}>{i.value}</output> {i.unit}
                </span>
              </span>
              <input
                type="range"
                name={i.id}
                min={i.min}
                max={i.max}
                step={i.step}
                value={i.value}
                class="mt-3 h-1.5 w-full cursor-pointer appearance-none rounded-full bg-sand-2 accent-ink [&::-webkit-slider-thumb]:size-5 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-white [&::-webkit-slider-thumb]:bg-ink [&::-webkit-slider-thumb]:shadow-[0_1px_4px_rgba(0,0,0,0.3)]"
              />
            </label>
          ))
        }
      </div>

      <div class="flex flex-col justify-between rounded-[14px] bg-ink p-6 text-white">
        <div>
          <p class="text-[14px] text-white/55">Tid som frigörs</p>
          <p class="mt-1 text-[40px] font-medium leading-none tracking-[-0.03em] tabular-nums"><span data-res="timmar">7</span> h<span class="text-[18px] text-white/55"> / mån</span></p>
          <p class="mt-6 text-[14px] text-white/55">Värde</p>
          <p class="mt-1 text-[40px] font-medium leading-none tracking-[-0.03em] tabular-nums"><span data-res="kronor">2 100</span> kr<span class="text-[18px] text-white/55"> / mån</span></p>
        </div>
        <p class="mt-8 border-t border-white/15 pt-4 text-[15px] leading-snug text-white/80">
          Chattbotten för {price.toLocaleString('sv-SE')} kr är betald efter <span class="font-semibold text-white" data-res="manader">3,8 månader</span>.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    const price = Number(root.dataset.price);
    const val = (n: string) => Number(root.querySelector<HTMLInputElement>(`input[name="${n}"]`)!.value);
    const set = (k: string, v: string) => root.querySelectorAll(`[data-res="${k}"]`).forEach((el) => (el.textContent = v));
    const nf = new Intl.NumberFormat('sv-SE', { maximumFractionDigits: 0 });
    const nf1 = new Intl.NumberFormat('sv-SE', { maximumFractionDigits: 1 });

    const update = () => {
      root.querySelectorAll<HTMLInputElement>('input[type="range"]').forEach((i) => {
        const out = root.querySelector(`[data-out="${i.name}"]`);
        if (out) out.textContent = i.value;
        const pct = ((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100;
        i.style.background = `linear-gradient(90deg, #141210 ${pct}%, #ebe7e0 ${pct}%)`;
      });
      const hours = (val('fragor') * val('minuter') * 20 * (val('andel') / 100)) / 60;
      const kr = hours * val('timpris');
      const months = kr > 0 ? price / kr : Infinity;
      set('timmar', nf1.format(hours));
      set('kronor', nf.format(Math.round(kr / 50) * 50));
      set('manader', months < 1 ? 'under en månad' : `${nf1.format(months)} månader`);
    };
    root.addEventListener('input', update);
    update();
  }
</script>
