// Håll texterna i linje med affärsplanen och CLAUDE.md: inga påhittade siffror eller kunder.
const items = [
  {
    id: 'detalj-pris',
    label: '/ Pris',
    title: 'Fast pris innan vi börjar',
    intro: 'Vi säger vad det kostar innan vi sätter igång, och det priset gäller.',
    points: [
      'Chatbotten kostar 8 000 kr i engångspris.',
