  {
    id: 'detalj-uppfoljning',
    label: '/ Efteråt',
    title: 'Uppföljning efter en vecka',
    intro: 'Vi lämnar inte över och försvinner. Vi hör av oss när chatbotten har varit igång en vecka.',
    points: [
      'Vi visar vad chatbotten kan och inte kan när vi lämnar över den.',
