---

<section aria-label="Mer information" class="bg-white pb-12 md:pb-20">
  <div class="wrap">
    <div class="mx-auto max-w-[1100px] divide-y divide-line border-y border-line">
      {
        items.map((it) => (
          <article id={it.id} class="grid gap-6 py-14 md:grid-cols-12 md:gap-10 md:py-20">
            <div class="md:col-span-5">
              <p class="label label-line">{it.label}</p>
              <h2 class="display mt-1 text-[34px] sm:text-5xl lg:text-[52px]">{it.title}</h2>
            </div>
            <div class="md:col-span-7">
              <p class="max-w-[48ch] text-[19px] font-medium leading-snug tracking-[-0.01em]">{it.intro}</p>
              <ul class="mt-6 grid gap-3 text-[16px] leading-relaxed text-ink/75">
                {it.points.map((p) => (
                  <li class="flex gap-3"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-sun"></span><span>{p}</span></li>
                ))}
              </ul>
              <a href={it.link.href} class="mt-8 inline-flex items-center gap-2 border-b border-ink/30 pb-0.5 text-[15px] font-medium hover:border-sun hover:text-sun">
                {it.link.text} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
