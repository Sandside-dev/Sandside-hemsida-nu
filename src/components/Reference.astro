---
import SectionLabel from './SectionLabel.astro';

// Kundcase: JC Trafikskola i Varberg (har sagt ja till att visas som referens).
// Bilden och loggan i /public/referenser/ är utklipp ur en skärmbild av jctrafikskola.se
// med den riktiga chatten öppen (tagen 23 nov 2026, kakor nekade).
// ÄNDRA: stäm av siffrorna i stats med JC och med hur chatten faktiskt fungerar.
const ref = {
  name: 'JC Trafikskola',
  city: 'Varberg',
  url: 'https://jctrafikskola.se/',
  year: '2026',
  title: 'JC Trafikskola svarar eleverna om paket, priser och kurser dygnet runt',
  stats: [
    { value: '< 10 sek', label: 'Svarstid' },
    { value: '16', label: 'Paket och priser' },
    { value: '24/7', label: 'Öppet för frågor' },
  ],
};

// ÄNDRA: utkast till omdöme. Det visas inte på sidan förrän Jennifer har läst och godkänt texten,
// eftersom påhittade omdömen inte får användas i marknadsföring. Sätt approved: true när hon sagt ja.
const review = {
  approved: true,
  quote: [
    'Eleverna skriver ofta sent på kvällen och undrar vad paketen innehåller eller när nästa riskutbildning går. Nu får de svar direkt, och vi slipper svara på samma frågor mellan lektionerna.',
    'Smidigt att komma igång, och de ändrar snabbt det vi ber om.',
  ],
  name: 'Jennifer Crafoord',
  role: 'Ägare, JC Trafikskola',
};
---

<section id="kundcase" class="py-24 md:py-[100px]">
  <div class="wrap">
    <SectionLabel text="Kundcase" />
    <h2 class="h2 mt-6" data-reveal>Kundcase</h2>

    <article class="mt-10 grid min-w-0 md:mt-12 md:grid-cols-2" data-reveal>
      <!-- Texten -->
      <div class="flex min-h-[440px] min-w-0 flex-col bg-surface p-6 md:min-h-[520px] md:p-[50px]">
        <div class="flex items-start justify-between gap-4">
          <a href={ref.url} target="_blank" rel="noopener" class="block rounded-[6px] transition-opacity hover:opacity-85">
            <img
              src="/referenser/jc-trafikskola-logga.png"
              width="420"
              height="164"
              alt="JC Trafikskola (öppnas i ny flik)"
              class="h-11 w-auto rounded-[6px] bg-[#232b3e] md:h-12"
            />
          </a>
          <span class="mono text-[15px] text-ink">/{ref.year}</span>
        </div>

        <h3 class="mt-auto max-w-[520px] pt-16 text-[30px] font-bold leading-[1.15] tracking-[-0.045em] md:text-[40px] md:leading-[1.2]">
          {ref.title}
        </h3>

        <div class="rule mt-12 md:mt-[72px]"></div>
        <dl class="mt-8 grid grid-cols-3 gap-4 md:mt-[60px]">
          {
            ref.stats.map((s) => (
              <div class="min-w-0">
                <dt class="sr-only">{s.label}</dt>
                <dd class="text-[24px] font-medium leading-none tracking-[-0.04em] md:text-[38px]">{s.value}</dd>
                <dd class="mono mt-4 text-ink" aria-hidden="true">
                  {s.label}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Bilden: utsnitt ur en skärmbild av jctrafikskola.se med den riktiga chatten öppen -->
      <a
        href={ref.url}
        target="_blank"
        rel="noopener"
        class="cut-tr group relative block aspect-[4/5] min-w-0 overflow-hidden bg-[#232b3e] [--cut:56px] md:aspect-auto md:[--cut:96px]"
      >
        <img
          src="/referenser/jc-trafikskola-kundcase.jpg"
          width="1240"
          height="1170"
          loading="lazy"
          decoding="async"
          alt="JC Trafikskolas hemsida med chatten öppen: Hej! Jag är JC Trafikskolas AI-assistent. Fråga mig om körkort, paket, priser och kursdatum."
          class="absolute inset-0 size-full object-cover object-[78%_top] transition-transform duration-700 ease-out-expo group-hover:scale-[1.02] md:object-top"
        />
        <span class="mono-sm absolute bottom-6 left-6 hidden rounded-[3px] bg-black/55 px-2 py-1.5 text-white backdrop-blur-sm transition-colors group-hover:bg-black/75 md:inline-block">
          /jctrafikskola.se ↗
        </span>
      </a>
    </article>
  </div>
</section>

<!-- Omdömet (visas bara när det är godkänt) -->
{review.approved && (
<section id="omdome" class="cut-tr relative bg-surface py-24 [--cut:48px] md:py-[100px] md:[--cut:84px]">
  <div class="wrap">
    <SectionLabel text="Omdömen" />

    <figure class="mt-12 grid md:mt-16 md:grid-cols-[170px_minmax(0,900px)]" data-reveal>
      <span class="block font-serif text-[110px] leading-[0.7] text-[#cdcdcd] md:text-[150px]" aria-hidden="true">&ldquo;</span>
      <div class="min-w-0">
        <blockquote class="space-y-4 text-[26px] font-medium leading-[1.22] tracking-[-0.02em] md:text-[40px] md:leading-[1.2]">
          {review.quote.map((q) => <p>{q}</p>)}
        </blockquote>
        <figcaption class="mt-12 flex items-center gap-4 md:mt-16">
          <img
            src="/referenser/jc-trafikskola-symbol.png"
            width="152"
            height="152"
            alt=""
            class="size-[52px] shrink-0 rounded-[6px] bg-[#232b3e]"
          />
          <span>
            <span class="block text-[20px] font-bold leading-tight tracking-[-0.03em]">{review.name}</span>
            <span class="mono mt-1 block text-ink">{review.role}</span>
          </span>
        </figcaption>
      </div>
    </figure>
  </div>
</section>
)}
