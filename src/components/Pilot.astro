---
import Button from './Button.astro';
import { site } from '../data/site';
const { current, promises } = site;
---

<section id="kunder" class="py-24 md:py-36">
  <div class="wrap">
    <div class="cut-tr grid gap-10 rounded-[6px] bg-sand p-7 [--cut:40px] md:grid-cols-12 md:p-14 md:[--cut:72px]" data-reveal>
      <div class="md:col-span-7">
        <p class="label label-line" data-scramble>/ Våra första kunder</p>
        <h2 class="display mt-1 text-[40px] sm:text-[56px] lg:text-[68px]">Bli en av våra första kunder</h2>
        <p class="mt-6 max-w-[52ch] text-[17px] leading-relaxed text-ink/75">
          Sandside är nytt, så vi har inga färdiga kundcase att visa än. Vi tänker inte hitta på några heller.
          Vi tar varje uppdrag på allvar, och när de första lösningarna är levererade berättar vi om resultatet här.
        </p>

        <div class="mt-8 flex max-w-[480px] items-start gap-3 rounded-[6px] border border-ink/10 bg-white px-4 py-3.5">
          <span class="mt-1.5 size-2.5 shrink-0 animate-pulse-dot rounded-full bg-sun"></span>
          <p class="text-[15px] leading-snug">
            <span class="font-mono text-[11px] uppercase tracking-[0.04em] text-muted">{current.label}</span><br />
            {current.text}
          </p>
        </div>
      </div>

      <div class="flex flex-col justify-end md:col-span-5">
        <p class="label mb-3">Det här får alla kunder</p>
        <ul class="space-y-3">
          {
            promises.map((p) => (
              <li class="flex items-start gap-3 rounded-[6px] bg-white px-4 py-3.5 text-[16px]">
                <svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <circle cx="9" cy="9" r="9" fill="#ff6a13" />
                  <path d="M5.5 9.2l2.3 2.3 4.7-4.9" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {p}
              </li>
            ))
          }
        </ul>

        <Button href="#boka" class="mt-5">Boka ett första möte</Button>
      </div>
    </div>
  </div>
</section>
