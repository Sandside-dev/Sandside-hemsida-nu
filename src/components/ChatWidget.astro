---
// Chatten nere till höger. ÄNDRA: det här är en demo med färdiga svar.
// Byt mot er riktiga chattbot (inbäddningskoden) när den är klar.
import { site, plans, formatKr } from '../data/site';

const startPrice = plans.find((p) => p.price !== null)?.price ?? null;
const symbol =
  '<svg viewBox="0 0 26 26" aria-hidden="true" class="size-[26px]"><path d="M4 14a9 9 0 0 1 18 0z" fill="#ff6a13"/><path d="M2.5 18.2c1.75 0 1.75-1.3 3.5-1.3s1.75 1.3 3.5 1.3 1.75-1.3 3.5-1.3 1.75 1.3 3.5 1.3 1.75-1.3 3.5-1.3 1.75 1.3 3.5 1.3" fill="none" stroke="#131313" stroke-width="1.8" stroke-linecap="round"/><path d="M5.5 22.4c1.25 0 1.25-1 2.5-1s1.25 1 2.5 1 1.25-1 2.5-1 1.25 1 2.5 1 1.25-1 2.5-1 1.25 1 2.5 1" fill="none" stroke="#131313" stroke-width="1.8" stroke-linecap="round" opacity=".45"/></svg>';
---

<div
  class="pointer-events-none fixed bottom-4 right-4 z-[60] flex flex-col items-end gap-3 md:bottom-6 md:right-6"
  data-chat
  data-email={site.email}
  data-start-price={startPrice ? formatKr(startPrice) : ''}
>
  <!-- Liten hälsning som dyker upp efter en stund -->
  <div
    class="pointer-events-auto w-[calc(100vw-32px)] max-w-[370px] rounded-[18px] bg-white p-5 shadow-[0_18px_50px_-12px_rgba(0,0,0,0.28),0_0_0_1px_rgba(0,0,0,0.04)]"
    data-teaser
    hidden
  >
    <div class="flex items-center justify-between">
      <span class="mono-sm flex items-center gap-2 text-muted">
        <span class="size-2 rounded-full bg-orange" aria-hidden="true"></span>
        {site.chat.name}
      </span>
      <button type="button" class="-m-2 grid size-9 place-items-center rounded-full text-ink/50 hover:bg-surface hover:text-ink" aria-label="Stäng hälsningen" data-teaser-close>
        <svg viewBox="0 0 12 12" class="size-3" fill="none" aria-hidden="true"><path d="m2 2 8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6"></path></svg>
      </button>
    </div>
    <p class="mt-3 text-[17px] font-bold leading-[1.35] tracking-[-0.02em]">Hej! Undrar du hur en chattbot skulle fungera hos er?</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button" class="inline-flex h-10 items-center gap-2 rounded-full bg-ink px-4 text-[15px] font-bold text-white hover:bg-black" data-ask="Jag vill skaffa en chattbot">
        Skaffa chattbot <span class="size-1.5 rounded-full bg-orange" aria-hidden="true"></span>
      </button>
      <button type="button" class="inline-flex h-10 items-center rounded-full border border-line bg-white px-4 text-[15px] font-bold hover:border-ink" data-ask="Vad kostar det?">
        Vad kostar det?
      </button>
    </div>
  </div>

  <!-- Själva chatten -->
  <div
    id="chattfonster"
    role="dialog"
    aria-label={site.chat.name}
    class="pointer-events-auto flex h-[min(600px,calc(100svh-110px))] w-[calc(100vw-32px)] max-w-[390px] origin-bottom-right flex-col overflow-hidden rounded-[18px] bg-white shadow-[0_24px_60px_-12px_rgba(0,0,0,0.35),0_0_0_1px_rgba(0,0,0,0.05)]"
    data-panel
    hidden
  >
    <div class="flex items-center gap-3 bg-ink px-4 py-3.5 text-white">
      <span class="grid size-10 shrink-0 place-items-center rounded-full bg-white ring-2 ring-orange" set:html={symbol} />
      <div class="min-w-0 flex-1">
        <p class="text-[16px] font-bold leading-tight tracking-[-0.02em]">{site.chat.name}</p>
        <p class="flex items-center gap-1.5 text-[13px] text-white/60">
          <span class="size-1.5 rounded-full bg-[#3ecf75]" aria-hidden="true"></span> Demo · svarar direkt
        </p>
      </div>
      <button type="button" class="grid size-10 place-items-center rounded-full text-white/70 hover:bg-white/10 hover:text-white" aria-label="Stäng chatten" data-close>
        <svg viewBox="0 0 12 12" class="size-3.5" fill="none" aria-hidden="true"><path d="m2 2 8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6"></path></svg>
      </button>
    </div>

    <div class="flex flex-1 flex-col gap-2 overflow-y-auto overscroll-contain px-4 py-4" data-log aria-live="polite"></div>

    <div class="flex gap-2 overflow-x-auto px-4 pb-3 [scrollbar-width:none]" data-suggestions>
      {
        ['Vad kostar det?', 'Hur fungerar det?', 'Hur lång tid tar det?', 'Boka demo'].map((q) => (
          <button
            type="button"
            class="h-9 shrink-0 rounded-full border border-line px-3.5 text-[14px] font-bold transition-colors hover:border-ink"
            data-ask={q}
          >
            {q}
          </button>
        ))
      }
    </div>

    <form class="flex items-center gap-2 border-t border-line p-3" data-form>
      <label for="chatt-fraga" class="sr-only">Skriv en fråga</label>
      <input
        id="chatt-fraga"
        name="fraga"
        autocomplete="off"
        placeholder="Skriv en fråga …"
        class="h-11 min-w-0 flex-1 rounded-full bg-surface px-4 text-[16px] placeholder:text-ink/45 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange"
      />
      <button type="submit" class="grid size-11 shrink-0 place-items-center rounded-full bg-orange text-ink transition-colors hover:bg-orange-light" aria-label="Skicka">
        <svg viewBox="0 0 16 16" class="size-4" fill="none" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" stroke="currentColor" stroke-width="1.8"></path></svg>
      </button>
    </form>
  </div>

  <!-- Knappen -->
  <button
    type="button"
    class="pointer-events-auto flex items-center gap-3 rounded-[16px] bg-ink p-1.5 text-white ring-1 ring-white/15 shadow-[0_14px_34px_-10px_rgba(0,0,0,0.5)] transition-transform hover:-translate-y-0.5"
    aria-expanded="false"
    aria-controls="chattfonster"
    data-launcher
  >
    <span class="grid size-11 place-items-center rounded-full bg-white ring-2 ring-orange" set:html={symbol} />
    <span class="pr-1 text-[17px] font-bold tracking-[-0.02em]">{site.chat.button}</span>
    <span class="relative grid size-11 place-items-center overflow-hidden rounded-[11px] bg-orange text-ink" aria-hidden="true">
      <svg viewBox="0 0 14 14" class="size-3.5 transition-transform duration-300" fill="none" data-icon-open>
        <path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.8"></path>
      </svg>
      <svg viewBox="0 0 12 12" class="absolute size-3.5 scale-0 transition-transform duration-300" fill="none" data-icon-close>
        <path d="m2 2 8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.8"></path>
      </svg>
    </span>
  </button>
</div>

<script>
  type Link = { href: string; label: string };
  type Rule = { k: RegExp; a: string; link?: Link };

  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    const teaser = root.querySelector<HTMLElement>('[data-teaser]')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const launcher = root.querySelector<HTMLButtonElement>('[data-launcher]')!;
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const iconOpen = launcher.querySelector<SVGElement>('[data-icon-open]')!;
    const iconClose = launcher.querySelector<SVGElement>('[data-icon-close]')!;
    const email = root.dataset.email || '';
    const startPrice = root.dataset.startPrice || '';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ÄNDRA: svaren nedan. De ska stämma med det som står på sidan.
    const rules: Rule[] = [
      {
        k: /skaffa|köpa|vill ha|komma igång|börja/i,
        a: 'Vad kul! Första steget är ett kort, kostnadsfritt samtal där vi går igenom vilka frågor era kunder brukar ställa. Sedan får ni ett fast pris innan vi börjar.',
        link: { href: '/#boka', label: 'Boka ett samtal' },
      },
      {
        k: /pris|kost|kr\b|betala|månad|dyr|billig/i,
        a: startPrice
          ? `Våra planer börjar på ${startPrice} kr i månaden, och ni väljer själva om ni vill betala månadsvis eller årsvis. Ni vet alltid vad det kostar innan vi börjar.`
          : 'Ni får ett fast pris efter första samtalet, så ni vet vad det kostar innan vi börjar.',
        link: { href: '/#priser', label: 'Se priserna' },
      },
      {
        k: /demo|boka|möte|samtal|träffa|ses/i,
        a: 'Gärna! I ett första samtal på ungefär 20 minuter visar vi hur chattbotten skulle kunna svara era kunder.',
        link: { href: '/#boka', label: 'Välj en tid' },
      },
      {
        k: /lång tid|snabbt|hur fort|när kan|klar/i,
        a: 'Själva bygget tar oftast några arbetsdagar. Eftersom vi också går i skolan blir det oftast en till några veckor från första mötet till att botten är live.',
      },
      {
        k: /fungerar|funkar|vad gör|hur gör|träna|lär/i,
        a: 'Vi tränar chattbotten på er information, som hemsida, priser och regler. Sedan lägger vi in den på er hemsida, där den svarar kunderna dygnet runt och skickar vidare frågor den inte kan svara på.',
      },
      {
        k: /tekni|kunna|it\b|installera|kod/i,
        a: 'Ni behöver inte kunna något tekniskt. Vi sätter upp allt, och ni får en skriftlig instruktion när botten lämnas över.',
      },
      {
        k: /gdpr|data|säker|personuppgift|lagra/i,
        a: 'Chattbotten svarar bara utifrån information ni har godkänt, och data hanteras inom EU.',
        link: { href: '/#sakerhet', label: 'Läs om säkerhet' },
      },
      {
        k: /vilka|vem|om er|sandside|uf\b|elev/i,
        a: 'Vi är fem elever från Göteborg som driver Sandside UF. Vi bygger chattbottar åt små företag.',
        link: { href: '/om-oss', label: 'Träffa teamet' },
      },
      {
        k: /människa|person|prata med|ring|kontakt|mejl|mail/i,
        a: `Självklart! Mejla oss på ${email} eller boka ett samtal, så hör vi av oss.`,
        link: { href: '/#boka', label: 'Boka ett samtal' },
      },
      { k: /^(hej|hallå|tjena|hejsan|god (morgon|dag|kväll))/i, a: 'Hej! Vad vill du veta? Fråga gärna om pris, hur det fungerar eller hur lång tid det tar.' },
      { k: /tack/i, a: 'Varsågod! Hör av dig om du undrar något mer.' },
    ];
    const fallback: Rule = {
      k: /./,
      a: 'Bra fråga! Jag är en demo med färdiga svar, så den kan jag inte svara på än. Boka ett samtal, så svarar vi på allt.',
      link: { href: '/#boka', label: 'Boka ett samtal' },
    };

    const scrollDown = () => log.scrollTo({ top: log.scrollHeight, behavior: reduce ? 'auto' : 'smooth' });

    const addMsg = (from: 'user' | 'bot', text: string, link?: Link) => {
      const wrap = document.createElement('div');
      wrap.className = `msg-in flex flex-col gap-2 ${from === 'user' ? 'items-end' : 'items-start'}`;
      const p = document.createElement('p');
      p.className =
        'max-w-[85%] rounded-[16px] px-3.5 py-2.5 text-[15px] leading-[1.45] ' +
        (from === 'user' ? 'rounded-br-[4px] bg-ink text-white' : 'rounded-bl-[4px] bg-surface text-ink');
      p.textContent = text;
      wrap.append(p);
      if (link) {
        const a = document.createElement('a');
        a.href = link.href;
        a.className = 'inline-flex h-9 items-center gap-2 rounded-full bg-orange px-3.5 text-[14px] font-bold text-ink hover:bg-orange-light';
        a.textContent = `${link.label} →`;
        a.addEventListener('click', () => setOpen(false, false));
        wrap.append(a);
      }
      log.append(wrap);
      scrollDown();
    };

    let busy = false;
    const reply = (text: string) => {
      const rule = rules.find((r) => r.k.test(text)) ?? fallback;
      const typing = document.createElement('p');
      typing.className = 'typing msg-in flex items-center gap-1 self-start rounded-[16px] rounded-bl-[4px] bg-surface px-3.5 py-3.5 text-ink';
      typing.innerHTML = '<span></span><span></span><span></span>';
      typing.setAttribute('aria-label', 'Skriver');
      log.append(typing);
      scrollDown();
      busy = true;
      setTimeout(
        () => {
          typing.remove();
          addMsg('bot', rule.a, rule.link);
          busy = false;
        },
        reduce ? 200 : 750,
      );
    };

    const ask = (text: string) => {
      const q = text.trim();
      if (!q || busy) return;
      addMsg('user', q);
      reply(q);
    };

    let greeted = false;
    const setOpen = (open: boolean, focus = true) => {
      panel.hidden = !open;
      launcher.setAttribute('aria-expanded', String(open));
      iconOpen.classList.toggle('scale-0', open);
      iconClose.classList.toggle('scale-0', !open);
      if (open) {
        hideTeaser();
        if (!greeted) {
          greeted = true;
          addMsg('bot', 'Hej! Jag är Sandsides chattbot. Det här är en demo, så att du ser hur det kan fungera på er hemsida. Vad undrar du?');
        }
        if (focus && window.matchMedia('(min-width: 768px)').matches) input.focus();
      } else if (focus) {
        launcher.focus();
      }
    };

    const hideTeaser = () => {
      teaser.hidden = true;
      try {
        sessionStorage.setItem('sandside-chat-teaser', '1');
      } catch {}
    };

    launcher.addEventListener('click', () => setOpen(panel.hidden));
    root.querySelector('[data-close]')!.addEventListener('click', () => setOpen(false));
    root.querySelector('[data-teaser-close]')!.addEventListener('click', hideTeaser);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
      input.value = '';
    });
    root.querySelectorAll<HTMLButtonElement>('[data-ask]').forEach((b) =>
      b.addEventListener('click', () => {
        if (panel.hidden) setOpen(true, false);
        ask(b.dataset.ask!);
      }),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });
    // Alla "Testa chatten"-knappar på sidan
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-open-chat]');
      if (!t) return;
      e.preventDefault();
      setOpen(true);
    });

    // Visa hälsningen efter en stund, en gång per besök
    let seen = false;
    try {
      seen = sessionStorage.getItem('sandside-chat-teaser') === '1';
    } catch {}
    if (!seen) {
      setTimeout(() => {
        if (panel.hidden) teaser.hidden = false;
      }, 3500);
    }
  }
</script>
