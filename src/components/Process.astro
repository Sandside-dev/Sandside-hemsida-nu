---
// Arbetsgången från affärsplanen, förenklad till fyra steg.
const steps = [
  { title: 'Vi lyssnar', text: 'Vi går igenom hur en vanlig vecka ser ut hos er och letar efter det som tar onödig tid.' },
  { title: 'Ni får ett fast pris', text: 'Vi gör upp om exakt vad vi ska bygga och vad det kostar innan vi börjar.' },
  { title: 'Vi bygger, ni testar', text: 'Ni provar lösningen med riktiga frågor innan den används av era kunder.' },
  { title: 'Leverans och uppföljning', text: 'Ni får en skriftlig instruktion, och vi hör av oss efter en vecka för att se att allt fungerar.' },
];
---

<section id="sa-funkar-det" class="section bg-sand">
  <div class="wrap">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <h2 class="h2 md:col-span-6">Så går det till</h2>
      <p class="lead md:col-span-6">
        Ni behöver inte kunna något om AI eller IT. Vi förklarar utan tekniska ord, och det tar oftast en till några
        veckor från första mötet.
      </p>
    </div>

    <ol class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <span class="absolute left-0 right-0 top-[15px] hidden h-px bg-ink/15 lg:block" aria-hidden="true"></span>
      {
        steps.map((s, i) => (
          <li class="relative" data-reveal style={`--d:${i * 90}ms`}>
            <span class:list={['relative grid size-8 place-items-center rounded-full text-[14px] font-semibold', i === 0 ? 'bg-sun text-white' : 'border border-ink/15 bg-sand text-ink']}>
              {i + 1}
            </span>
            <h3 class="h3 mt-5">{s.title}</h3>
            <p class="mt-2 max-w-[34ch] text-[16px] text-ink/70">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
