---
import Logo from './Logo.astro';
import { meetingHref, meetingLabel } from '../data/site';

const links = [
  { href: '/', label: 'Startsida', path: '/' },
  { href: '/om-oss', label: 'Om oss', path: '/om-oss' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!-- Sidhuvudet har ljus bakgrund hela tiden (mörk startsida). Förra läget: border-transparent överst, och data-[scrolled]:border-line data-[scrolled]:bg-white/90 data-[scrolled]:backdrop-blur-md vid scroll. -->
<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-white/90 backdrop-blur-md"
>
  <div class="wrap flex h-16 items-center justify-between">
    <a href="/" aria-label="Sandside, till toppen av sidan"><Logo /></a>

    <nav aria-label="Huvudmeny" class="flex items-center gap-1 sm:gap-2">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={currentPath === l.path ? 'page' : undefined}
            class="rounded-[6px] px-3 py-2 text-[15px] font-medium transition-colors hover:bg-sand aria-[current=page]:bg-sand"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={meetingHref}
        class="ml-1 hidden h-10 items-center rounded-[6px] border border-ink bg-white px-4 text-sm font-medium transition-colors hover:bg-ink hover:text-white sm:inline-flex"
      >
        {meetingLabel}
      </a>
    </nav>
  </div>
</header>
