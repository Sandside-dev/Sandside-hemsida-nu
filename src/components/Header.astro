---
import Logo from './Logo.astro';
import { meetingHref, meetingLabel } from '../data/site';

const links = [
  { href: '/', label: 'Startsida', path: '/' },
  { href: '/om-oss', label: 'Om oss', path: '/om-oss' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled]:border-line data-[scrolled]:bg-white/90 data-[scrolled]:backdrop-blur-md"
>
  <div class="wrap flex h-16 items-center justify-between">
    <a href="/" aria-label="Sandside, till toppen av sidan"><Logo /></a>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-menu-btn
        aria-expanded="false"
        aria-controls="meny"
        aria-label="Öppna meny"
        class="group grid size-10 place-items-center rounded-[6px] border border-line bg-white transition-colors hover:border-ink"
      >
        <span class="relative block h-3 w-4" aria-hidden="true">
          <span class="absolute left-0 top-0 h-[1.5px] w-4 bg-ink transition-transform duration-300 group-aria-expanded:translate-y-[5px] group-aria-expanded:rotate-45"></span>
          <span class="absolute left-0 top-[5px] h-[1.5px] w-4 bg-ink transition-opacity duration-200 group-aria-expanded:opacity-0"></span>
          <span class="absolute left-0 top-[10px] h-[1.5px] w-4 bg-ink transition-transform duration-300 group-aria-expanded:-translate-y-[5px] group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
      <a
        href={meetingHref}
        class="hidden h-10 items-center rounded-[6px] border border-ink bg-white px-4 text-sm font-medium transition-colors hover:bg-ink hover:text-white sm:inline-flex"
      >
        {meetingLabel}
      </a>
    </div>
  </div>

  <nav
    id="meny"
    data-menu
    aria-label="Huvudmeny"
    class="pointer-events-none invisible absolute right-5 top-[68px] w-[min(360px,calc(100vw-40px))] translate-y-2 rounded-[10px] border border-line bg-white p-3 opacity-0 shadow-[0_24px_60px_-20px_rgba(0,0,0,0.25)] transition-all duration-300 data-[open]:pointer-events-auto data-[open]:visible data-[open]:translate-y-0 data-[open]:opacity-100 md:right-10"
  >
    <ul>
      {
        links.map((l, i) => (
          <li>
            <a
              href={l.href}
              aria-current={currentPath === l.path ? 'page' : undefined}
              class="group flex items-baseline gap-4 rounded-[6px] px-3 py-3 transition-colors hover:bg-sand aria-[current=page]:bg-sand"
            >
              <span class="font-mono text-[11px] text-muted group-hover:text-sun">/{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[22px] font-bold tracking-[-0.03em]" data-scramble-hover>{l.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={meetingHref}
      class="mt-2 flex items-center justify-between rounded-[6px] bg-ink px-4 py-3.5 text-[15px] font-medium text-white"
    >
      {meetingLabel}
      <span class="grid size-8 place-items-center rounded-[4px] bg-sun" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4.5 11.5l7-7M5.5 4.5h6v6"></path></svg>
      </span>
    </a>
  </nav>
</header>
