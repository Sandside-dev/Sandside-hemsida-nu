---
import Logo from './Logo.astro';

const links = [
  { href: '/#losningar', label: 'Lösningar' },
  { href: '/#kalkyl', label: 'Räkna själv' },
  { href: '/#priser', label: 'Priser' },
  { href: '/#om-oss', label: 'Om oss' },
  { href: '/#fragor', label: 'Frågor' },
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-white/85 backdrop-blur-md transition-colors duration-300 data-[scrolled]:border-line"
>
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href="/" aria-label="Sandside, till startsidan"><Logo /></a>

    <nav aria-label="Huvudmeny" class="hidden md:block">
      <ul class="flex items-center gap-7 text-[15px] text-ink/75">
        {links.map((l) => <li><a href={l.href} class="transition-colors hover:text-ink">{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#boka" class="inline-flex h-10 items-center rounded-full bg-ink px-5 text-[15px] font-medium text-white transition-colors hover:bg-black">
        Boka möte
      </a>
      <button
        type="button"
        data-menu-btn
        aria-expanded="false"
        aria-controls="mobilmeny"
        aria-label="Öppna meny"
        class="group grid size-10 place-items-center rounded-full border border-line md:hidden"
      >
        <span class="relative block h-2.5 w-4" aria-hidden="true">
          <span class="absolute left-0 top-0 h-[1.5px] w-4 bg-ink transition-transform duration-300 group-aria-expanded:translate-y-[4.5px] group-aria-expanded:rotate-45"></span>
          <span class="absolute bottom-0 left-0 h-[1.5px] w-4 bg-ink transition-transform duration-300 group-aria-expanded:-translate-y-[4.5px] group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
    </div>
  </div>

  <nav
    id="mobilmeny"
    data-menu
    aria-label="Mobilmeny"
    class="pointer-events-none invisible absolute inset-x-0 top-16 border-b border-line bg-white opacity-0 transition-opacity duration-200 data-[open]:pointer-events-auto data-[open]:visible data-[open]:opacity-100 md:hidden"
  >
    <ul class="wrap py-3">
      {links.map((l) => <li><a href={l.href} class="block border-b border-line py-4 text-[20px] font-medium last:border-0">{l.label}</a></li>)}
    </ul>
  </nav>
</header>
