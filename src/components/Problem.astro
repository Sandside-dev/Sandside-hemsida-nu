---
const questions = [
  { time: '07:12', text: 'När öppnar ni i morgon?' },
  { time: '18:46', text: 'Vilka tjänster erbjuder ni?' },
  { time: '21:05', text: 'Hur bokar jag en tid?' },
  { time: '22:18', text: 'Vad behöver jag förbereda inför besöket?' },
];
---

<section id="problem" aria-labelledby="problem-rubrik" class="border-t border-line bg-white py-24 md:py-36">
  <div class="wrap grid gap-12 md:grid-cols-12 md:items-start">
    <div class="md:sticky md:top-28 md:col-span-6">
      <p class="label label-line" data-scramble>/ Frågor när ni inte hinner</p>
      <h2 id="problem-rubrik" class="display mt-1 max-w-[11ch] text-[44px] sm:text-6xl lg:text-[76px]">
        Samma frågor. Varje dag.
      </h2>
      <p class="mt-6 max-w-[42ch] text-[17px] leading-relaxed text-ink/75" data-reveal>
        Besökare vill ha svar direkt. En chatbot på hemsidan tar hand om de återkommande frågorna och hänvisar
        vidare när en människa behöver ta över.
      </p>
    </div>

    <ul class="grid gap-3 md:col-span-6" aria-label="Exempel på återkommande kundfrågor">
      {
        questions.map((question, i) => (
          <li class="rounded-[10px] border border-line bg-sand p-5 md:p-6" data-reveal style={`--d:${i * 80}ms`}>
            <div class="flex items-center justify-between gap-4">
              <span class="font-mono text-[11px] uppercase tracking-[0.04em] text-muted">Besökare · {question.time}</span>
              <span class="rounded-full bg-sun-soft px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.04em] text-sun-dark">
                Vanlig fråga
              </span>
            </div>
            <p class="mt-3 text-[19px] font-medium leading-snug tracking-[-0.01em]">”{question.text}”</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
