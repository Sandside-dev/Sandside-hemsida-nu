---
// Scroll-berättelse: frågor från olika kanaler dyker upp vid fel tider, som notiser.
// Frågorna kommer från våra målbranscher: trafikskolor, frisörer, tatuerare, PT och hantverkare.
// x/y = position på dator, mx/my = position på mobil (procent).
const messages = [
  { source: 'Hemsidan', icon: 'web', time: 'Mån 07:12', text: 'Hej! Kan ni komma och titta på en läcka i dag?', x: 3, y: 12, mx: 4, my: 9 },
  { source: 'Telefon', icon: 'call', time: 'Tis 18:46', text: 'Missat samtal', x: 71, y: 9, mx: 30, my: 17 },
  { source: 'Mejl', icon: 'mail', time: 'Ons 21:05', text: 'Hur många körlektioner brukar man behöva?', x: 1, y: 44, mx: 6, my: 25 },
  { source: 'Instagram', icon: 'dm', time: 'Tor 22:18', text: 'Vad kostar en liten tatuering på handleden?', x: 77, y: 40, mx: 28, my: 63 },
  { source: 'Telefon', icon: 'call', time: 'Fre 16:59', text: '2 missade samtal', x: 6, y: 76, mx: 4, my: 70 },
  { source: 'Instagram', icon: 'dm', time: 'Lör 08:30', text: 'Finns det någon tid för klippning i dag?', x: 72, y: 74, mx: 26, my: 77 },
  { source: 'Hemsidan', icon: 'web', time: 'Sön 20:14', text: 'Kan man testa en PT-timme innan man köper ett kort?', x: 37, y: 9, mx: 8, my: 84 },
];

const icons: Record<string, string> = {
  web: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.5 3.5 5.3 3.5 8.5s-1.1 6-3.5 8.5c-2.4-2.5-3.5-5.3-3.5-8.5S9.6 6 12 3.5z"/>',
  call: '<path d="M20 15.8v2.6a1.8 1.8 0 0 1-2 1.8A16.6 16.6 0 0 1 3.8 6 1.8 1.8 0 0 1 5.6 4h2.6a1.8 1.8 0 0 1 1.8 1.5l.4 2.3a1.8 1.8 0 0 1-.5 1.6l-1.2 1.2a13 13 0 0 0 4.8 4.8l1.2-1.2a1.8 1.8 0 0 1 1.6-.5l2.3.4a1.8 1.8 0 0 1 1.4 1.7z"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M4 7l8 6 8-6"/>',
  dm: '<rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.6" cy="7.4" r="0.6" fill="currentColor"/>',
};
---

<section id="problem" aria-labelledby="problem-rubrik" class="relative bg-sand">
  <div data-problem class="relative h-[240vh] motion-reduce:h-auto">
    <div class="sticky top-0 h-svh overflow-hidden motion-reduce:relative motion-reduce:h-auto motion-reduce:min-h-svh motion-reduce:py-24">
      <div class="pointer-events-none absolute inset-0 z-10 grid place-items-center px-6 text-center motion-reduce:relative motion-reduce:mb-12">
        <div class="max-w-[620px]">
          <h2 id="problem-rubrik" class="h2 mx-auto max-w-[16ch] !text-[clamp(34px,4.6vw,60px)]">
            Kunderna hör av sig när det passar dem
          </h2>
          <p data-p-line2 class="lead mx-auto mt-5 max-w-[40ch]">
            Ofta på kvällar och helger, eller mitt i ett jobb. Varje fråga som blir liggande är en kund som kanske bokar
            någon annanstans.
          </p>
        </div>
      </div>

      {
        messages.map((m) => (
          <div
            data-msg
            class="absolute left-[var(--mx)] top-[var(--my)] w-[min(268px,72vw)] rounded-[16px] bg-white/95 px-3.5 py-3 shadow-[0_1px_2px_rgba(0,0,0,0.06),0_12px_32px_-16px_rgba(0,0,0,0.2)] backdrop-blur md:left-[min(var(--x),calc(100%-290px))] md:top-[var(--y)] md:w-[258px] motion-reduce:static motion-reduce:mx-auto motion-reduce:mb-3"
            style={`--x:${m.x}%;--y:${m.y}%;--mx:${m.mx}%;--my:${m.my}%`}
          >
            <div class="flex items-center gap-2">
              <span class:list={['grid size-6 place-items-center rounded-[7px]', m.icon === 'call' ? 'bg-sun text-white' : 'bg-ink text-white']}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[m.icon]} />
              </span>
              <span class="text-[13px] font-semibold">{m.source}</span>
              <span class="ml-auto text-[12px] text-muted">{m.time}</span>
            </div>
            <p class:list={['mt-1.5 text-[15px] leading-snug', m.icon === 'call' && 'text-ink/60']}>{m.icon === 'call' ? m.text : `”${m.text}”`}</p>
            <p data-tag class="mt-2 text-[12px] font-medium text-sun-dark">Obesvarad</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const section = document.querySelector<HTMLElement>('[data-problem]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && !reduce) {
    gsap.registerPlugin(ScrollTrigger);
    const msgs = section.querySelectorAll('[data-msg]');
    const tags = section.querySelectorAll('[data-tag]');

    const tl = gsap.timeline({
      defaults: { ease: 'power2.out' },
      scrollTrigger: { trigger: section, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
    });

    msgs.forEach((m, i) => {
      tl.fromTo(m, { autoAlpha: 0, y: 24, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, duration: 1 }, i * 0.6);
    });

    tl.fromTo('[data-p-line2]', { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 1 }, '+=0.1')
      .fromTo(tags, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.4, stagger: 0.06 }, '<')
      .to({}, { duration: 0.6 });
  }
</script>
