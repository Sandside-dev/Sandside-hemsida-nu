---
import Button from './Button.astro';
import Logo from './Logo.astro';
import { site, nav, telHref } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="cut-tr relative overflow-hidden bg-ink text-white [--cut:48px] md:[--cut:84px]">
  <div class="wrap pt-28 md:pt-[170px]">
    <!-- Avslutande uppmaning + loggan i 3D -->
    <div class="grid items-center gap-14 md:grid-cols-2 md:gap-10">
      <div data-reveal>
        <h2 class="h2 max-w-[11ch]">Redo att låta chattbotten svara?</h2>
        <div class="mt-8 md:mt-10">
          <Button href="/#boka" variant="orange" class="w-full sm:w-auto sm:min-w-[330px]">Boka kostnadsfri demo</Button>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[300px] md:mr-6 md:ml-auto" data-reveal style="--d:120ms">
        <!-- Ledningar som går ut från rutan -->
        <span class="pointer-events-none absolute right-full top-[38%] hidden h-px w-[40vw] max-w-[420px] bg-linear-to-l from-orange/70 to-transparent md:block" aria-hidden="true"></span>
        <span class="pointer-events-none absolute right-full top-[62%] hidden h-px w-[26vw] max-w-[260px] bg-linear-to-l from-white/25 to-transparent md:block" aria-hidden="true"></span>
        <span class="pointer-events-none absolute left-full top-[50%] hidden h-px w-[20vw] max-w-[160px] bg-linear-to-r from-orange/60 to-transparent md:block" aria-hidden="true"></span>

        <div
          class="relative aspect-square w-full overflow-hidden rounded-[28px] border border-white/10 shadow-[0_0_80px_-10px_rgba(255,106,19,0.35),inset_0_1px_0_rgba(255,255,255,0.08)]"
          style="background: radial-gradient(90% 75% at 50% 100%, rgba(255,106,19,0.28), transparent 70%), linear-gradient(180deg, #1b1b1b, #0b0b0b);"
        >
          <canvas
            data-logo-3d
            data-dark
            aria-hidden="true"
            class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000 [&.is-ready]:opacity-100"
          ></canvas>
        </div>
      </div>
    </div>

    <!-- Kryssen -->
    <div class="mt-20 flex justify-between text-white/30 md:mt-28" aria-hidden="true">
      {[0, 1, 2].map(() => <span class="text-[22px] font-light leading-none">+</span>)}
    </div>

    <!-- Kolumner -->
    <div class="mt-14 grid gap-12 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.9fr)_1fr_1fr_0.85fr] lg:gap-8">
      <div>
        <p class="mono-sm text-white/50">/E-post</p>
        <a href={`mailto:${site.email}`} class="mt-2 block break-words text-[26px] font-bold tracking-[-0.04em] text-orange transition-colors hover:text-orange-light md:text-[32px]">
          {site.email}
        </a>
        {
          site.phone && (
            <>
              <p class="mono-sm mt-6 text-white/50">/Telefon</p>
              <a href={telHref(site.phone)} class="mt-2 block text-[22px] font-medium tracking-[-0.02em] hover:text-white/70">
                {site.phone}
              </a>
            </>
          )
        }
        <p class="mono-sm mt-6 text-white/50">/Ort</p>
        <p class="mt-2 text-[22px] font-medium tracking-[-0.02em]">{site.city}</p>
      </div>

      <nav aria-label="Sidfot">
        <p class="mono-sm text-white/50">/Navigation</p>
        <ul class="mt-2 space-y-3">
          <li><a href="/" class="text-[20px] font-medium tracking-[-0.02em] hover:text-white/60 md:text-[22px]">Hem</a></li>
          {
            nav.map((n) => (
              <li>
                <a href={n.href} class="text-[20px] font-medium tracking-[-0.02em] hover:text-white/60 md:text-[22px]">
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="mono-sm text-white/50">/Företaget</p>
        <ul class="mt-2 space-y-3">
          <li><a href="/om-oss" class="text-[20px] font-medium tracking-[-0.02em] hover:text-white/60 md:text-[22px]">Om oss</a></li>
          <li><a href="/#boka" class="text-[20px] font-medium tracking-[-0.02em] hover:text-white/60 md:text-[22px]">Kontakta oss</a></li>
        </ul>
        <p class="mono-sm mt-10 text-white/50">/Juridik</p>
        <ul class="mt-2 space-y-3">
          <li><a href="/integritetspolicy" class="text-[20px] font-medium tracking-[-0.02em] hover:text-white/60 md:text-[22px]">Integritetspolicy</a></li>
        </ul>
      </div>

      <div>
        <p class="mono-sm text-white/50">/Följ oss</p>
        <ul class="mt-2 space-y-3">
          {
            site.social.map((s) => (
              <li>
                <a href={s.href} class="text-[20px] font-medium tracking-[-0.02em] hover:text-white/60 md:text-[22px]">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="rule rule-dark mt-20" data-reveal></div>
    <p class="mono-sm mt-4 text-white/50">
      <span class="sr-only">© {year} {site.legalName}</span><span aria-hidden="true" data-scramble>©{year} {site.legalName} · {site.city}{site.orgNr ? ` · Org.nr ${site.orgNr}` : ''}</span>
    </p>
  </div>

  <!-- Stor logga längst ner -->
  <div class="wrap mt-16 overflow-hidden md:mt-24" aria-hidden="true">
    <div class="-mb-[6%] text-[#1f1f1f]">
      <Logo tone="mono" class="block h-auto w-full" />
    </div>
  </div>
</footer>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('footer [data-logo-3d][data-dark]');
  if (canvas) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        import('../scripts/logo3d').then((m) => m.initLogo3D(canvas, { dark: true, z: 15.5 }));
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(canvas);
  }
</script>
