---
import Button from './Button.astro';
import Logo from './Logo.astro';
import { site, telHref, meetingHref, meetingLabel } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="on-dark overflow-hidden bg-ink text-white">
  <div class="wrap pt-20 md:pt-28">
    <div class="flex flex-col gap-8 border-b border-white/15 pb-14 md:flex-row md:items-end md:justify-between">
      <h2 class="display max-w-[14ch] text-[40px] sm:text-[56px] lg:text-[64px]">Ska vi prata chatbot?</h2>
      <Button href={meetingHref} variant="light" class="w-full max-w-[360px]">{meetingLabel}</Button>
    </div>

    <div class="grid gap-10 py-14 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <Logo inverted />
        <p class="mt-4 max-w-[28ch] text-[15px] leading-relaxed text-white/55">Chatbotar för företags hemsidor.</p>
      </div>
      <div>
        <p class="label">Chatbotar</p>
        <ul class="mt-4 space-y-2.5 text-[15px] text-white/80">
          <li><a href="/#erbjudandet" class="hover:text-sun">Erbjudandet</a></li>
          <li><a href="/#chatt" class="hover:text-sun">Testa chatbotten</a></li>
          <li><a href="/#priser" class="hover:text-sun">Priser</a></li>
        </ul>
      </div>
      <div>
        <p class="label">Företaget</p>
        <ul class="mt-4 space-y-2.5 text-[15px] text-white/80">
          <li><a href="/" class="hover:text-sun">Startsida</a></li>
          <li><a href="/om-oss" class="hover:text-sun">Om oss</a></li>
          <li><a href="/#kunder" class="hover:text-sun">Kunder</a></li>
          <li><a href="/#sakerhet" class="hover:text-sun">Säkerhet</a></li>
          <li><a href="/#fragor" class="hover:text-sun">Vanliga frågor</a></li>
        </ul>
      </div>
      <div>
        <p class="label">Kontakt</p>
        <ul class="mt-4 space-y-2.5 text-[15px] text-white/80">
          <li><a href={`mailto:${site.email}`} class="hover:text-sun">{site.email}</a></li>
          <li><a href={telHref(site.salesPhone)} class="hover:text-sun">{site.salesPhone}</a></li>
          <li class="text-white/55">{site.city}</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="wrap flex flex-col gap-2 border-t border-white/15 py-6 font-mono text-[11px] uppercase tracking-[0.04em] text-white/45 sm:flex-row sm:justify-between">
    <span>© {year} {site.legalName} · Ett UF-företag inom Ung Företagsamhet</span>
    <a href="/integritetspolicy" class="hover:text-white">Integritetspolicy</a>
  </div>
</footer>
