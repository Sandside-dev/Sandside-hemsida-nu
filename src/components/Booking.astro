---
import { site, bookingContact } from '../data/site';

const initials = bookingContact.name
  .split(' ')
  .map((p) => p[0])
  .join('')
  .toUpperCase();
---

<section id="boka" class="py-24 md:py-[100px]">
  <div class="wrap">
    <div class="text-center" data-reveal>
      <h2 class="text-[34px] font-medium leading-[1.1] tracking-[-0.035em] md:text-[44px]">Boka ett första samtal</h2>
      <p class="mx-auto mt-3 max-w-[470px] text-[16px] leading-[1.5] text-muted">
        Vi visar hur en chattbot kan svara era kunder och går igenom vad den skulle kunna ta hand om hos er.
      </p>
    </div>

    <div
      class="mx-auto mt-10 grid max-w-[846px] overflow-hidden rounded-[14px] border border-line bg-white md:mt-12 md:grid-cols-[320px_minmax(0,1fr)]"
      data-booking
      data-email={site.email}
      data-reveal
    >
      <!-- Vem ni pratar med -->
      <div class="border-b border-line p-6 md:border-b-0 md:border-r">
        <div class="flex items-center gap-4">
          {
            bookingContact.photo ? (
              <img
                src={bookingContact.photo}
                alt={bookingContact.name}
                width="96"
                height="112"
                class="h-[112px] w-[96px] rounded-[10px] object-cover"
              />
            ) : (
              <span class="relative grid h-[112px] w-[96px] shrink-0 place-items-center overflow-hidden rounded-[10px] bg-ink">
                <span class="relative z-10 text-[28px] font-bold tracking-[-0.04em] text-white">{initials}</span>
                <span class="absolute -bottom-7 left-1/2 size-16 -translate-x-1/2 rounded-full bg-orange" aria-hidden="true" />
              </span>
            )
          }
          <div>
            <p class="text-[17px] font-bold leading-tight tracking-[-0.02em]">{bookingContact.name}</p>
            <p class="mt-1 text-[14px] leading-[1.4] text-muted">{bookingContact.role}, {site.legalName}</p>
          </div>
        </div>

        <ul class="mt-7 space-y-3.5 text-[15px]">
          <li class="flex items-center gap-3">
            <svg viewBox="0 0 20 20" class="size-[18px] shrink-0 text-ink/70" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5"></circle>
              <path d="M10 6v4l2.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            Ca 20 minuter
          </li>
          <li class="flex items-center gap-3">
            <svg viewBox="0 0 20 20" class="size-[18px] shrink-0 text-ink/70" fill="none" aria-hidden="true">
              <rect x="3" y="4.5" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
              <path d="M3 8.5h14M7 3v3M13 3v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <span data-summary class="text-muted">Välj dag och tid</span>
          </li>
          <li class="flex items-center gap-3">
            <svg viewBox="0 0 20 20" class="size-[18px] shrink-0 text-ink/70" fill="none" aria-hidden="true">
              <rect x="2.75" y="5.25" width="10.5" height="9.5" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
              <path d="m13.5 8.5 3.75-2.25v7.5L13.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
            </svg>
            Video eller telefon
          </li>
        </ul>
      </div>

      <!-- Kalender, tider och formulär (byggs av skriptet nedan) -->
      <div class="min-h-[470px] p-5 md:p-6" data-panel>
        <p class="text-[15px] text-muted">
          Mejla oss på <a class="font-bold text-ink underline" href={`mailto:${site.email}`}>{site.email}</a> så hittar vi en tid.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // ÄNDRA: bokningen skickar just nu ett förifyllt mejl. Koppla gärna till Cal.com eller liknande.
  const TIMES = ['15:30', '16:00', '16:30', '17:00', '17:30']; // ÄNDRA: era tider
  const DAYS_AHEAD = 45;

  const root = document.querySelector<HTMLElement>('[data-booking]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const email = root.dataset.email || '';

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const first = new Date(today);
    first.setDate(first.getDate() + 1);
    const last = new Date(today);
    last.setDate(last.getDate() + DAYS_AHEAD);
    const isAvail = (d: Date) => d >= first && d <= last && d.getDay() !== 0 && d.getDay() !== 6;

    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
    const fmtMonth = new Intl.DateTimeFormat('sv-SE', { month: 'long', year: 'numeric' });
    const fmtLong = new Intl.DateTimeFormat('sv-SE', { weekday: 'long', day: 'numeric', month: 'long' });
    const longDate = (d: Date) => cap(fmtLong.format(d));

    let view = new Date(first.getFullYear(), first.getMonth(), 1);
    let selDate: Date | null = null;
    let selTime: string | null = null;

    const arrow =
      '<svg viewBox="0 0 14 14" fill="none"><path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.8"/></svg>';
    const back = (label: string) =>
      `<button type="button" data-back class="-ml-1 inline-flex items-center gap-1.5 rounded-[4px] px-1 py-1 text-[15px] text-muted transition-colors hover:text-ink">
        <svg viewBox="0 0 16 16" class="size-4" fill="none" aria-hidden="true"><path d="M13 8H3m4.5-4.5L3 8l4.5 4.5" stroke="currentColor" stroke-width="1.6"/></svg>${label}</button>`;

    const focusHeading = () => panel.querySelector<HTMLElement>('[data-focus]')?.focus({ preventScroll: true });

    const updateSummary = () => {
      if (!selDate) {
        summary.textContent = 'Välj dag och tid';
        summary.classList.add('text-muted');
        return;
      }
      summary.textContent = `${longDate(selDate)}${selTime ? `, kl. ${selTime}` : ''}`;
      summary.classList.remove('text-muted');
    };

    // ── 1. Kalendern ──────────────────────────────────────
    const renderCalendar = (focus = false) => {
      const y = view.getFullYear();
      const m = view.getMonth();
      const offset = (new Date(y, m, 1).getDay() + 6) % 7; // måndag först
      const days = new Date(y, m + 1, 0).getDate();
      const canPrev = view > new Date(first.getFullYear(), first.getMonth(), 1);
      const canNext = view < new Date(last.getFullYear(), last.getMonth(), 1);

      let cells = '';
      for (let i = 0; i < offset; i++) cells += '<span aria-hidden="true"></span>';
      for (let d = 1; d <= days; d++) {
        const date = new Date(y, m, d);
        const ok = isAvail(date);
        const sel = !!selDate && date.getTime() === selDate.getTime();
        const isToday = date.getTime() === today.getTime();
        const state = sel
          ? 'bg-orange font-bold text-ink'
          : ok
            ? 'bg-surface font-bold text-ink hover:bg-ink hover:text-white'
            : 'text-ink/30';
        cells += `<button type="button" data-day="${d}" ${ok ? '' : 'disabled'} aria-pressed="${sel}"
          aria-label="${longDate(date)}${ok ? '' : ', inte bokningsbar'}"
          class="relative mx-auto grid size-10 place-items-center rounded-full text-[15px] transition-colors md:size-11 ${state}">
          ${d}${isToday ? '<span class="absolute bottom-1 left-1/2 size-1 -translate-x-1/2 rounded-full bg-ink/45" aria-hidden="true"></span>' : ''}
        </button>`;
      }

      panel.innerHTML = `
        <div class="flex items-center justify-between">
          <h3 class="text-[17px] font-bold tracking-[-0.02em]" tabindex="-1" data-focus>${cap(fmtMonth.format(view))}</h3>
          <div class="flex gap-1">
            <button type="button" data-month="-1" ${canPrev ? '' : 'disabled'} aria-label="Föregående månad"
              class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-surface disabled:text-ink/25 disabled:hover:bg-transparent">
              <svg viewBox="0 0 16 16" class="size-4" fill="none" aria-hidden="true"><path d="m10 3-5 5 5 5" stroke="currentColor" stroke-width="1.7"/></svg>
            </button>
            <button type="button" data-month="1" ${canNext ? '' : 'disabled'} aria-label="Nästa månad"
              class="grid size-10 place-items-center rounded-full text-ink transition-colors hover:bg-surface disabled:text-ink/25 disabled:hover:bg-transparent">
              <svg viewBox="0 0 16 16" class="size-4" fill="none" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.7"/></svg>
            </button>
          </div>
        </div>
        <div class="mt-5 grid grid-cols-7 text-center text-[13px] text-muted" aria-hidden="true">
          <span>Mån</span><span>Tis</span><span>Ons</span><span>Tor</span><span>Fre</span><span>Lör</span><span>Sön</span>
        </div>
        <div class="mt-3 grid grid-cols-7 gap-y-2" role="group" aria-label="Dagar i ${fmtMonth.format(view)}">${cells}</div>
        <p class="mt-6 text-[13px] text-muted">Grå dagar går att boka. Alla tider är svensk tid.</p>`;

      panel.querySelectorAll<HTMLButtonElement>('[data-month]').forEach((b) =>
        b.addEventListener('click', () => {
          view = new Date(y, m + Number(b.dataset.month), 1);
          renderCalendar();
          const same = panel.querySelector<HTMLButtonElement>(`[data-month="${b.dataset.month}"]:not(:disabled)`);
          if (same) same.focus();
          else focusHeading();
        }),
      );
      panel.querySelectorAll<HTMLButtonElement>('[data-day]:not(:disabled)').forEach((b) =>
        b.addEventListener('click', () => {
          selDate = new Date(y, m, Number(b.dataset.day));
          selTime = null;
          updateSummary();
          renderTimes();
        }),
      );
      if (focus) focusHeading();
    };

    // ── 2. Tiderna ────────────────────────────────────────
    const renderTimes = () => {
      if (!selDate) return renderCalendar(true);
      panel.innerHTML = `
        ${back('Byt dag')}
        <h3 class="mt-4 text-[22px] font-bold tracking-[-0.03em] outline-none" tabindex="-1" data-focus>${longDate(selDate)}</h3>
        <p class="mt-1 text-[15px] text-muted">Välj en tid som passar. Samtalet tar ungefär 20 minuter.</p>
        <div class="mt-6 grid gap-2 sm:grid-cols-2">
          ${TIMES.map(
            (t) => `<button type="button" data-time="${t}" aria-pressed="${selTime === t}"
              class="h-12 rounded-[6px] border text-[16px] font-bold tracking-[-0.01em] transition-colors ${
                selTime === t ? 'border-orange bg-orange text-ink' : 'border-line hover:border-ink'
              }">${t}</button>`,
          ).join('')}
        </div>`;
      panel.querySelector('[data-back]')!.addEventListener('click', () => renderCalendar(true));
      panel.querySelectorAll<HTMLButtonElement>('[data-time]').forEach((b) =>
        b.addEventListener('click', () => {
          selTime = b.dataset.time!;
          updateSummary();
          renderForm();
        }),
      );
      focusHeading();
    };

    // ── 3. Formuläret ─────────────────────────────────────
    const field = (name: string, label: string, opts: { type?: string; auto?: string; required?: boolean; area?: boolean } = {}) => {
      const id = `bok-${name}`;
      const base =
        'mt-1.5 w-full rounded-[6px] border border-line bg-white px-3.5 text-[16px] text-ink transition-colors placeholder:text-ink/35 hover:border-ink/40 focus:border-ink focus:outline-none aria-[invalid=true]:border-[#c62828]';
      const input = opts.area
        ? `<textarea id="${id}" name="${name}" rows="3" class="${base} py-3"></textarea>`
        : `<input id="${id}" name="${name}" type="${opts.type ?? 'text'}" ${opts.auto ? `autocomplete="${opts.auto}"` : ''} ${
            opts.required ? 'required aria-required="true"' : ''
          } class="${base} h-12" />`;
      return `<div>
        <label for="${id}" class="text-[14px] font-bold">${label}${opts.required ? ' <span class="text-[#c62828]" aria-hidden="true">*</span>' : ''}</label>
        ${input}
        <p id="${id}-fel" class="mt-1.5 hidden text-[13px] text-[#c62828]" data-error></p>
      </div>`;
    };

    const renderForm = () => {
      if (!selDate || !selTime) return renderTimes();
      panel.innerHTML = `
        ${back('Byt tid')}
        <h3 class="mt-4 text-[22px] font-bold tracking-[-0.03em] outline-none" tabindex="-1" data-focus>${longDate(selDate)}, kl. ${selTime}</h3>
        <form class="mt-5 grid gap-4" novalidate data-form>
          <div class="grid gap-4 sm:grid-cols-2">
            ${field('namn', 'Namn', { auto: 'name', required: true })}
            ${field('epost', 'E-post', { type: 'email', auto: 'email', required: true })}
            ${field('foretag', 'Företag', { auto: 'organization' })}
            ${field('telefon', 'Telefon', { type: 'tel', auto: 'tel' })}
          </div>
          ${field('meddelande', 'Vad ska chattbotten kunna svara på?', { area: true })}
          <button type="submit" class="btn btn-dark w-full">
            <span>Skicka bokningen</span>
            <span class="btn-icon" aria-hidden="true">${arrow}${arrow}</span>
          </button>
          <p class="text-[13px] leading-[1.45] text-muted">Bokningen öppnas som ett mejl till oss. Skicka mejlet så bekräftar vi tiden.</p>
        </form>`;
      panel.querySelector('[data-back]')!.addEventListener('click', renderTimes);

      const form = panel.querySelector<HTMLFormElement>('[data-form]')!;
      const showError = (input: HTMLInputElement, msg: string) => {
        const err = panel.querySelector<HTMLElement>(`#${input.id}-fel`)!;
        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
        if (msg) input.setAttribute('aria-describedby', err.id);
        else input.removeAttribute('aria-describedby');
        err.textContent = msg;
        err.classList.toggle('hidden', !msg);
      };
      const check = (input: HTMLInputElement) => {
        const v = input.value.trim();
        if (input.name === 'namn') return v ? '' : 'Skriv ditt namn.';
        if (input.name === 'epost')
          return !v ? 'Skriv din e-postadress.' : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) ? '' : 'Kontrollera e-postadressen, till exempel namn@foretag.se.';
        return '';
      };
      const required = [...form.querySelectorAll<HTMLInputElement>('input[required]')];
      required.forEach((i) => i.addEventListener('blur', () => i.value && showError(i, check(i))));

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const bad: HTMLInputElement[] = [];
        for (const i of required) {
          const msg = check(i);
          showError(i, msg);
          if (msg) bad.push(i);
        }
        if (bad.length) return bad[0].focus();

        const data = new FormData(form);
        const when = `${longDate(selDate!)}, kl. ${selTime}`;
        const body = [
          `Jag vill boka ett första samtal: ${when}.`,
          '',
          `Namn: ${data.get('namn')}`,
          `E-post: ${data.get('epost')}`,
          data.get('foretag') ? `Företag: ${data.get('foretag')}` : '',
          data.get('telefon') ? `Telefon: ${data.get('telefon')}` : '',
          data.get('meddelande') ? `\nVad botten ska svara på:\n${data.get('meddelande')}` : '',
        ]
          .filter((l) => l !== '')
          .join('\n');
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(`Bokning: ${when}`)}&body=${encodeURIComponent(body)}`;
        renderDone(when);
      });
      focusHeading();
    };

    // ── 4. Klart ──────────────────────────────────────────
    const renderDone = (when: string) => {
      panel.innerHTML = `
        <div class="flex h-full min-h-[400px] flex-col items-start justify-center">
          <span class="grid size-12 place-items-center rounded-full bg-orange text-ink" aria-hidden="true">
            <svg viewBox="0 0 20 20" class="size-5" fill="none"><path d="m4.5 10.5 3.5 3.5 7.5-8" stroke="currentColor" stroke-width="2"/></svg>
          </span>
          <h3 class="mt-5 text-[24px] font-bold tracking-[-0.03em] outline-none" tabindex="-1" data-focus>Nästan klart!</h3>
          <p class="mt-2 max-w-[400px] text-[16px] leading-[1.5] text-muted">
            Ditt mejlprogram öppnas med bokningen för ${when} ifylld. Skicka mejlet så bekräftar vi tiden.
          </p>
          <p class="mt-4 text-[15px] text-muted">Öppnades inget mejl? Skriv till <a class="font-bold text-ink underline" href="mailto:${email}">${email}</a>.</p>
          <button type="button" data-restart class="mt-8 text-[15px] font-bold underline underline-offset-4">Boka en annan tid</button>
        </div>`;
      panel.querySelector('[data-restart]')!.addEventListener('click', () => {
        selDate = null;
        selTime = null;
        updateSummary();
        renderCalendar(true);
      });
      focusHeading();
    };

    renderCalendar();
  }
</script>
