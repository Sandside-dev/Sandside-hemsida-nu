---
import Button from './Button.astro';
import { site, meetingHref, meetingLabel } from '../data/site';
---

<section id="boka" class="border-t border-line bg-white py-24 md:py-36">
  <div class="wrap">
    <div class="cut-tr mx-auto grid max-w-[1000px] gap-10 rounded-[6px] bg-sand p-7 [--cut:40px] md:grid-cols-12 md:p-14 md:[--cut:72px]" data-reveal>
      <div class="md:col-span-7">
        <p class="label label-line" data-scramble>/ Första samtalet</p>
        <h2 class="display mt-1 text-[44px] sm:text-6xl lg:text-[68px]">Prata chatbot med oss</h2>
        <p class="mt-6 max-w-[52ch] text-[17px] leading-relaxed text-ink/75">
          Berätta om företaget och vilka frågor ni ofta får. Vi pratar igenom om en chatbot passar och vad den i så
          fall behöver kunna. Ett första samtal tar ungefär 20 minuter.
        </p>
      </div>

      <div class="flex flex-col justify-end md:col-span-5">
        <div class="rounded-[6px] bg-white p-5">
          <p class="font-bold">Föreslå tider som passar</p>
          <p class="mt-2 text-[15px] leading-relaxed text-ink/70">
            Knappen öppnar ett mejlutkast till {site.email} med plats för företag och önskade tider. Vi återkommer
            och bekräftar en tid.
          </p>
        </div>
        <Button href={meetingHref} class="mt-4">{meetingLabel}</Button>
      </div>
    </div>
  </div>
</section>
