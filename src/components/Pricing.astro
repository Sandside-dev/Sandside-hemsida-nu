---
import SectionLabel from './SectionLabel.astro';
import Button from './Button.astro';
import { plans, formatKr, yearlyDiscount } from '../data/site';

const yearly = (p: number) => Math.round((p * (1 - yearlyDiscount)) / 10) * 10 - 1;
---

<section id="priser" class="py-24 md:py-[100px]" data-pricing>
  <div class="wrap">
    <SectionLabel text="Priser" />
    <div class="mt-6 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <h2 class="h2" data-reveal>Välj er plan</h2>

      <div class="flex w-full rounded-[4px] bg-ink p-1 sm:w-auto" role="group" aria-label="Betalning" data-reveal>
        <button
          type="button"
          class="flex flex-1 items-center justify-center gap-2 whitespace-nowrap rounded-[3px] px-3 py-2.5 text-[15px] sm:gap-2.5 sm:px-4 sm:text-[17px] font-bold tracking-[-0.02em] text-white transition-colors sm:flex-none"
          aria-pressed="false"
          data-period="year"
        >
          Årsvis
          <span class="mono-sm rounded-[2px] bg-white/12 px-1.5 py-1 text-white" data-badge>Spara {Math.round(yearlyDiscount * 100)}%</span>
        </button>
        <button
          type="button"
          class="flex flex-1 items-center justify-center whitespace-nowrap rounded-[3px] bg-orange px-3 py-2.5 text-[15px] sm:px-4 sm:text-[17px] font-bold tracking-[-0.02em] text-ink transition-colors sm:flex-none"
          aria-pressed="true"
          data-period="month"
        >
          Ingen bindningstid
        </button>
      </div>
    </div>

    <div class="mt-12 grid gap-4 md:mt-16 lg:grid-cols-3 lg:items-start lg:gap-[22px]">
      {
        plans.map((p, i) => (
          <article
            class:list={[
              'cut-tr flex flex-col p-6 [--cut:36px] md:p-8',
              p.featured ? 'bg-ink text-white lg:-mt-10 lg:pb-12' : 'bg-surface',
              i === 2 && 'lg:-mt-4',
            ]}
            data-reveal
            style={`--d:${i * 90}ms`}
          >
            <h3 class:list={['text-[22px] font-bold leading-tight tracking-[-0.03em]', p.featured && 'text-orange']}>{p.name}</h3>
            <p class:list={['mt-1 min-h-[42px] text-[15px] leading-[1.4]', p.featured ? 'text-white/65' : 'text-muted']}>{p.tagline}</p>

            <div class="mt-8 flex min-h-[56px] items-end gap-2">
              {p.price !== null ? (
                <>
                  <span class="text-[48px] font-bold leading-none tracking-[-0.03em]">
                    <span data-price data-month={formatKr(p.price)} data-year={formatKr(yearly(p.price))}>
                      {formatKr(p.price)}
                    </span>
                    <span class="text-[30px]"> kr</span>
                  </span>
                  <span class:list={['mono pb-1', p.featured ? 'text-white/55' : 'text-muted']}>/månad</span>
                </>
              ) : (
                <span class="text-[48px] font-bold leading-none tracking-[-0.03em]">Få offert</span>
              )}
            </div>
            <p class:list={['mono-sm mt-3 h-3', p.featured ? 'text-white/55' : 'text-muted']} data-note>
              {p.price !== null ? 'Betalas månadsvis' : 'Fast pris efter första mötet'}
            </p>

            <div class:list={['rule mt-6', p.featured && 'rule-dark']} />

            <ul class="mt-7 space-y-3.5">
              {p.features.map((f) => (
                <li class="flex gap-3 text-[16px] leading-[1.4]">
                  <span
                    class:list={[
                      'mt-[2px] grid size-[18px] shrink-0 place-items-center rounded-[3px]',
                      p.featured ? 'bg-orange text-ink' : 'bg-[#d9d9d9] text-ink',
                    ]}
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 12 12" class="size-[11px]" fill="none">
                      <path d="m2.5 6.2 2.3 2.3 4.7-5" stroke="currentColor" stroke-width="1.8" />
                    </svg>
                  </span>
                  {f}
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-10">
              <Button href="#boka" variant={p.featured ? 'orange' : 'dark'} class="w-full" data-plan={p.name}>
                {p.cta}
              </Button>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-pricing]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-period]')];
    const prices = [...root.querySelectorAll<HTMLElement>('[data-price]')];
    const notes = [...root.querySelectorAll<HTMLElement>('[data-note]')];

    const set = (period: 'month' | 'year') => {
      buttons.forEach((b) => {
        const on = b.dataset.period === period;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('bg-orange', on);
        b.classList.toggle('text-ink', on);
        b.classList.toggle('text-white', !on);
        const badge = b.querySelector<HTMLElement>('[data-badge]');
        if (badge) {
          badge.classList.toggle('bg-ink', on);
          badge.classList.toggle('text-orange', on);
          badge.classList.toggle('bg-white/12', !on);
          badge.classList.toggle('text-white', !on);
        }
      });
      prices.forEach((p) => (p.textContent = period === 'year' ? p.dataset.year! : p.dataset.month!));
      notes.forEach((n) => {
        if (n.textContent?.startsWith('Fast pris')) return;
        n.textContent = period === 'year' ? 'Per månad, betalas årsvis' : 'Betalas månadsvis';
      });
    };
    buttons.forEach((b) => b.addEventListener('click', () => set(b.dataset.period as 'month' | 'year')));
  }
</script>
