---
import Button from './Button.astro';
import { plans } from '../data/site';

const main = plans.find((p) => p.id === 'chattbot')!;
const others = [
  { name: 'AI-receptionist', text: 'Svarar i telefon när ni inte hinner' },
  { name: 'Hemsida', text: 'Fungerar i mobilen, ni kan ändra själva' },
  { name: 'Automatiska flöden', text: 'Bokning, bekräftelser och påminnelser' },
  { name: 'AI-genomgång', text: 'Skriftlig lista över var ni kan spara tid' },
];
---

<section id="priser" class="section border-t border-line">
  <div class="wrap">
    <div class="max-w-[640px]">
      <h2 class="h2">Vad det kostar</h2>
      <p class="lead mt-5">Ni betalar en gång för bygget. Sedan är lösningen er, utan månadsavgifter till oss.</p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-12 [&>*]:min-w-0">
      <article class="flex flex-col rounded-[20px] bg-sand p-7 md:p-10 lg:col-span-7" data-reveal>
        <div class="flex flex-wrap items-start justify-between gap-6">
          <div>
            <h3 class="text-[24px] font-medium tracking-[-0.02em]">{main.name}</h3>
            <p class="mt-1 text-muted">{main.tagline}</p>
          </div>
          <p class="text-right">
            <span class="block text-[56px] font-medium leading-none tracking-[-0.04em] tabular-nums md:text-[64px]">
              {main.price?.toLocaleString('sv-SE')} kr
            </span>
            <span class="mt-2 block text-[14px] text-muted">Engångspris</span>
          </p>
        </div>
        <ul class="mt-10 grid gap-x-8 border-t border-ink/10 sm:grid-cols-2">
          {main.features.map((f) => <li class="border-b border-ink/10 py-3.5 text-[16px]">{f}</li>)}
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href="#boka">{main.cta}</Button>
          <p class="text-[14px] text-muted">Driften av AI och verktyg betalar ni direkt till leverantören.</p>
        </div>
      </article>

      <div class="rounded-[20px] border border-line p-7 md:p-10 lg:col-span-5" data-reveal style="--d:100ms">
        <h3 class="text-[24px] font-medium tracking-[-0.02em]">Övriga lösningar</h3>
        <p class="mt-1 text-muted">Fast pris efter första mötet</p>
        <ul class="mt-8 border-t border-line">
          {
            others.map((o) => (
              <li class="border-b border-line py-4">
                <p class="font-medium">{o.name}</p>
                <p class="text-[15px] text-muted">{o.text}</p>
              </li>
            ))
          }
        </ul>
        <Button href="#boka" variant="text" class="mt-6">Få ett fast pris</Button>
      </div>
    </div>
  </div>
</section>
