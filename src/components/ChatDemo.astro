---
// Chattdemon i toppen: välj bransch och se ett exempelsamtal skrivas fram.
import { demos } from '../data/demos';
---

<div class="mx-auto w-full max-w-[440px]" data-chat-demo data-demos={JSON.stringify(demos)}>
  <div class="mb-3 flex gap-1.5 overflow-x-auto pb-1 [scrollbar-width:none]" role="tablist" aria-label="Välj bransch">
    {
      demos.map((d, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-demo-tab={d.id}
          class="shrink-0 rounded-full border border-white/70 bg-white/80 px-3.5 py-1.5 text-[14px] font-medium text-ink/70 backdrop-blur transition-colors hover:text-ink aria-selected:border-ink aria-selected:bg-ink aria-selected:text-white"
        >
          {d.tab}
        </button>
      ))
    }
  </div>

  <div class="overflow-hidden rounded-[20px] border border-ink/10 bg-white shadow-[0_40px_80px_-30px_rgba(60,20,0,0.45)]">
    <div class="flex items-center gap-3 border-b border-line px-4 py-3">
      <span class="grid size-9 place-items-center rounded-full bg-ink text-[13px] font-semibold text-white" data-demo-initial>T</span>
      <div class="min-w-0 flex-1">
        <p class="truncate text-[15px] font-semibold leading-tight" data-demo-business>Trafikskolan</p>
        <p class="flex items-center gap-1.5 text-[12px] text-muted">
          <span class="size-1.5 rounded-full bg-[#2fa84f]"></span>Chattbot · svarar direkt
        </p>
      </div>
      <span class="rounded-full bg-sand px-2 py-0.5 text-[11px] font-medium text-muted">Exempel</span>
    </div>

    <div class="flex h-[380px] flex-col justify-end gap-2.5 overflow-hidden px-4 pb-4 pt-3 sm:h-[400px]" data-demo-log aria-live="polite">
      <!-- fylls av skriptet -->
    </div>
  </div>
</div>

<script>
  type Msg = { from: 'kund' | 'bot'; text: string; action?: string };
  type Demo = { id: string; tab: string; business: string; time: string; messages: Msg[]; outcome: { type: string; text: string } };

  const root = document.querySelector<HTMLElement>('[data-chat-demo]');
  if (root) {
    const demos = JSON.parse(root.dataset.demos || '[]') as Demo[];
    const log = root.querySelector<HTMLElement>('[data-demo-log]')!;
    const business = root.querySelector<HTMLElement>('[data-demo-business]')!;
    const initial = root.querySelector<HTMLElement>('[data-demo-initial]')!;
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-demo-tab]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let run = 0; // avbryter pågående uppspelning när man byter flik
    let auto = true;
    let visible = true;

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    const add = (html: string) => {
      const el = document.createElement('div');
      el.innerHTML = html;
      const node = el.firstElementChild as HTMLElement;
      if (!reduce) node.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)' });
      log.append(node);
      while (log.scrollHeight > log.clientHeight + 4 && log.children.length > 2) log.firstElementChild?.remove();
      return node;
    };

    const bubble = (m: Msg) =>
      m.from === 'kund'
        ? `<div class="flex justify-end"><p class="max-w-[82%] rounded-[16px] rounded-br-[5px] bg-ink px-3.5 py-2.5 text-[15px] leading-snug text-white">${esc(m.text)}</p></div>`
        : `<div class="flex flex-col items-start gap-1.5"><p class="max-w-[86%] rounded-[16px] rounded-bl-[5px] bg-sand px-3.5 py-2.5 text-[15px] leading-snug">${esc(m.text)}</p>${
            m.action ? `<span class="ml-1 inline-flex items-center gap-1.5 rounded-full border border-ink/15 bg-white px-3 py-1.5 text-[13px] font-medium">${esc(m.action)} <span aria-hidden="true">→</span></span>` : ''
          }</div>`;

    const typing = () =>
      add(`<div class="flex"><p class="flex gap-1 rounded-[16px] rounded-bl-[5px] bg-sand px-4 py-3.5" aria-label="skriver">${[0, 1, 2]
        .map((i) => `<span class="size-1.5 animate-blink rounded-full bg-ink/60" style="animation-delay:${i * 180}ms"></span>`)
        .join('')}</p></div>`);

    async function play(index: number) {
      const id = ++run;
      const d = demos[index];
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === index)));
      business.textContent = d.business;
      initial.textContent = d.business.charAt(0);
      log.innerHTML = '';
      add(`<p class="pb-1 text-center font-mono text-[11px] text-muted">${esc(d.time)}</p>`);

      if (reduce) {
        d.messages.forEach((m) => add(bubble(m)));
      } else {
        for (const m of d.messages) {
          if (m.from === 'bot') {
            const t = typing();
            await wait(900 + Math.min(m.text.length * 9, 1100));
            t.remove();
          } else {
            await wait(700);
          }
          if (id !== run) return;
          add(bubble(m));
          await wait(m.from === 'kund' ? 500 : 1300);
          if (id !== run) return;
        }
      }
      const handover = d.outcome.type === 'handover';
      add(
        `<p class="mt-1 flex items-center justify-center gap-1.5 text-[12px] font-medium ${handover ? 'text-sun-dark' : 'text-muted'}"><span class="size-1.5 rounded-full ${handover ? 'bg-sun' : 'bg-[#2fa84f]'}"></span>${esc(d.outcome.text)}</p>`,
      );
      if (reduce || !auto) return;
      await wait(4200);
      while (!visible && id === run) await wait(500);
      if (id === run && auto) play((index + 1) % demos.length);
    }

    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        auto = false;
        play(i);
      }),
    );
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
    play(0);
  }
</script>
