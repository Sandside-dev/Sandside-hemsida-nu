---
import { site, telHref } from '../data/site';

const more = [
  {
    title: 'Hemsidor',
    text: 'För er som saknar hemsida eller har en gammal. Den fungerar i mobilen, och ni får en egen inloggning så att ni kan ändra texter och bilder själva.',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  },
  {
    title: 'Automatiska flöden',
    text: 'En kund bokar. Bekräftelsen skickas, tiden hamnar i kalendern och en påminnelse går ut dagen innan. Utan att någon gör det för hand.',
    icon: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.5 6H15a3 3 0 0 1 3 3v6.5M6 8.5V15a3 3 0 0 0 3 3h6.5"/>',
  },
  {
    title: 'AI-genomgång',
    text: 'Vi går igenom en vanlig arbetsvecka hos er och ger er en skriftlig lista över var AI och automatisering kan spara mest tid.',
    icon: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2M8.5 11h5M11 8.5v5"/>',
  },
];
---

<section id="losningar" class="py-24 md:py-36">
  <div class="wrap">
    <div class="grid items-end gap-6 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="label label-line" data-scramble>/ Våra lösningar</p>
        <h2 class="display mt-1 text-[44px] sm:text-6xl lg:text-[76px]">Enkla lösningar på det som tar tid</h2>
      </div>
      <p class="text-[17px] leading-relaxed text-ink/75 md:col-span-5 md:pb-2" data-reveal>
        Vi börjar alltid med att ta reda på vad som tar onödig tid hos er. Sen bygger vi det som passar,
        anpassat efter hur just ni jobbar.
      </p>
    </div>

    <div class="mt-12 grid gap-4 md:mt-16 md:grid-cols-2">
      <article data-card="chat" class="group flex flex-col rounded-[6px] bg-sand p-6 md:p-9" data-reveal>
        <div class="relative -mx-2 h-[230px] md:h-[280px]">
          <canvas data-icon-chat aria-hidden="true" class="absolute inset-0 size-full opacity-0 transition-opacity duration-700 [&.is-ready]:opacity-100"></canvas>
        </div>
        <p class="label mt-4">/01 · Hemsidan</p>
        <h3 class="mt-2 text-[28px] font-bold leading-tight tracking-[-0.03em] md:text-[34px]">Chattbot för hemsidan</h3>
        <p class="mt-3 max-w-[48ch] text-[16px] leading-relaxed text-ink/70">
          Svarar på kundernas vanligaste frågor dygnet runt: priser, öppettider och hur man bokar. Personalen
          slipper svara på samma sak om och om igen.
        </p>
        <ul class="mt-6 space-y-2 border-t border-ink/10 pt-5 text-[15px]">
          <li class="flex gap-2.5"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-sun"></span>Svarar dygnet runt, i er ton</li>
          <li class="flex gap-2.5"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-sun"></span>Svarar bara utifrån er egen information</li>
          <li class="flex gap-2.5"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-sun"></span>Svåra frågor går vidare till er personal</li>
        </ul>
      </article>

      <article data-card="voice" class="group flex flex-col rounded-[6px] bg-sand p-6 md:p-9" data-reveal style="--d:120ms">
        <div class="relative -mx-2 h-[230px] md:h-[280px]">
          <canvas data-icon-voice aria-hidden="true" class="absolute inset-0 size-full opacity-0 transition-opacity duration-700 [&.is-ready]:opacity-100"></canvas>
        </div>
        <p class="label mt-4">/02 · Telefonen</p>
        <h3 class="mt-2 text-[28px] font-bold leading-tight tracking-[-0.03em] md:text-[34px]">AI-receptionist i telefon</h3>
        <p class="mt-3 max-w-[48ch] text-[16px] leading-relaxed text-ink/70">
          Tar samtalen när ni står på en stege, sitter i möte eller har gått hem. Den pratar med kunden,
          bokar in en tid och mejlar en sammanfattning till er efter varje samtal.
        </p>
        {
          site.demoPhone ? (
            <a
              href={telHref(site.demoPhone)}
              class="mt-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-ink/10 pt-5 text-[15px] transition-colors hover:text-sun-dark"
            >
              <span>Ring och prata med den själv</span>
              <span class="flex items-center gap-2 whitespace-nowrap font-mono text-[15px] font-medium">
                <span class="size-2 animate-pulse-dot rounded-full bg-sun" />
                {site.demoPhone}
              </span>
            </a>
          ) : (
            <a
              href="#boka"
              class="mt-6 flex items-center justify-between gap-4 border-t border-ink/10 pt-5 text-[15px] transition-colors hover:text-sun-dark"
            >
              <span>Vill du veta hur den skulle funka hos er? Boka ett möte.</span>
              <span class="grid size-8 shrink-0 place-items-center rounded-[4px] bg-white" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" /></svg>
              </span>
            </a>
          )
        }
      </article>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {
        more.map((s, i) => (
          <article class="group flex flex-col rounded-[6px] border border-line p-6 transition-colors hover:border-ink md:p-7" data-reveal style={`--d:${i * 100}ms`}>
            <div class="flex items-center justify-between">
              <span class="grid size-11 place-items-center rounded-[6px] bg-sand transition-colors group-hover:bg-sun group-hover:text-white">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
              </span>
              <span class="label">/{String(i + 3).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-6 text-[22px] font-bold tracking-[-0.02em]">{s.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink/70">{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const chat = document.querySelector<HTMLCanvasElement>('[data-icon-chat]');
  const voice = document.querySelector<HTMLCanvasElement>('[data-icon-voice]');
  import('../scripts/icon3d').then(({ initChatIcon, initVoiceIcon }) => {
    if (chat) initChatIcon(chat, chat.closest('article')!);
    if (voice) initVoiceIcon(voice, voice.closest('article')!);
  });
</script>
