---
import SectionLabel from './SectionLabel.astro';

const cards = [
  {
    icon: 'bubble',
    title: 'Chattbot för hemsidan',
    text: 'En digital kollega som svarar på kundernas frågor dygnet runt. Den är tränad på er information, som priser, öppettider och regler, och svarar i er ton.',
  },
  {
    icon: 'plane',
    title: 'Skickar vidare till er',
    text: 'När en fråga kräver en människa tar chattbotten namn och kontaktuppgifter och skickar ärendet till er. Ingen kund blir utan svar.',
  },
];
---

<section id="losningen" class="py-24 md:py-[150px]">
  <div class="wrap">
    <SectionLabel text="Vår lösning" />
    <div class="mt-6 grid gap-5 md:grid-cols-2 md:gap-10">
      <h2 class="h2" data-reveal>Vår chattbot</h2>
      <p class="max-w-[500px] text-[16px] leading-[1.5] md:justify-self-end md:pt-2" data-reveal style="--d:100ms">
        Vi bygger chattbottar som faktiskt används. De tränas på er verksamhet, finns på hemsidan dygnet runt och
        lämnar över till er när det behövs. Ni testar botten innan den går live.
      </p>
    </div>

    <div class="mt-10 grid gap-2 md:mt-14 md:grid-cols-2">
      {
        cards.map((c, i) => (
          <article
            class="group relative flex min-h-[400px] flex-col justify-end overflow-hidden bg-surface p-6 transition-colors duration-300 hover:bg-[#eeeeee] md:min-h-[330px]"
            data-reveal
            data-icon-card
            style={`--d:${i * 100}ms`}
          >
            <canvas
              data-icon-3d
              data-icon={c.icon}
              aria-hidden="true"
              class="pointer-events-none absolute -right-4 -top-4 h-[230px] w-[290px] opacity-0 transition-opacity duration-700 md:-top-6 md:right-0 md:h-[250px] md:w-[320px] [&.is-ready]:opacity-100"
            />
            <h3 class="h3 relative">{c.title}</h3>
            <p class="relative mt-3 max-w-[400px] text-[16px] leading-[1.5]">{c.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const canvases = [...document.querySelectorAll<HTMLCanvasElement>('[data-icon-3d]')];
  if (canvases.length) {
    // Ladda 3D först när korten närmar sig skärmen
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../scripts/icons3d').then(({ initBubbleIcon, initPlaneIcon }) => {
          canvases.forEach((c) => {
            const card = c.closest<HTMLElement>('[data-icon-card]') ?? c;
            if (c.dataset.icon === 'bubble') initBubbleIcon(c, card);
            else initPlaneIcon(c, card);
          });
        });
      },
      { rootMargin: '400px 0px' },
    );
    canvases.forEach((c) => io.observe(c));
  }
</script>
