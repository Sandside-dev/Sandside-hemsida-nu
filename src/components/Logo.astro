---
// Sandsides logga (solen över vågorna + ordbilden), samma fil som i /logo.
// tone="ink" = svart text, "white" = vit text, "mono" = allt i textfärgen (används i sidfotens stora logga).
import raw from '../assets/sandside-logo.svg?raw';

interface Props {
  class?: string;
  tone?: 'ink' | 'white' | 'mono';
  title?: string;
}
const { class: cls = 'h-[26px] w-auto', tone = 'ink', title } = Astro.props;

let svg = raw
  .replace(/<title>.*?<\/title>/, '')
  .replace(/\swidth="[^"]*"/, '')
  .replace(/\sheight="[^"]*"/, '')
  .replace(/#121212/g, 'currentColor');
if (tone === 'mono') svg = svg.replace(/#ff6a13/g, 'currentColor');

const color = tone === 'white' ? 'text-white' : tone === 'ink' ? 'text-ink' : '';
svg = svg.replace(
  '<svg ',
  `<svg class="${cls} ${color}" ${title ? `role="img" aria-label="${title}"` : 'aria-hidden="true"'} focusable="false" `,
);
---

<Fragment set:html={svg} />
