---
// Ordbild: en sol som går upp över vågor + namnet.
interface Props {
  class?: string;
  inverted?: boolean;
}
const { class: cls = '', inverted = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', cls]}>
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <path d="M4 14a9 9 0 0 1 18 0z" fill="#ff6a13"></path>
    <path
      d="M2.5 18.2c1.75 0 1.75-1.3 3.5-1.3s1.75 1.3 3.5 1.3 1.75-1.3 3.5-1.3 1.75 1.3 3.5 1.3 1.75-1.3 3.5-1.3 1.75 1.3 3.5 1.3"
      stroke={inverted ? '#fff' : '#121212'}
      stroke-width="1.8"
      stroke-linecap="round"></path>
    <path
      d="M5.5 22.4c1.25 0 1.25-1 2.5-1s1.25 1 2.5 1 1.25-1 2.5-1 1.25 1 2.5 1 1.25-1 2.5-1 1.25 1 2.5 1"
      stroke={inverted ? '#fff' : '#121212'}
      stroke-width="1.8"
      stroke-linecap="round"
      opacity="0.45"></path>
  </svg>
  <span class:list={['text-[19px] font-bold tracking-[-0.03em]', inverted ? 'text-white' : 'text-ink']}>Sandside</span>
</span>
