---
// Knapp med pilruta till höger. Pilen glider ut och en ny glider in vid hover.
// variant: dark (svart med orange ruta), light (vit), orange (orange med svart ruta)
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href?: string;
  variant?: 'dark' | 'light' | 'orange';
  class?: string;
  type?: 'button' | 'submit';
} & Omit<HTMLAttributes<'a'>, 'type'> &
  Record<`data-${string}`, string | boolean>;

const { href, variant = 'dark', class: cls = '', type = 'button', ...rest } = Astro.props;
const classes = ['btn', `btn-${variant}`, cls];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <span class="truncate">
        <slot />
      </span>
      <span class="btn-icon" aria-hidden="true">
        <svg viewBox="0 0 14 14" fill="none">
          <path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.8" />
        </svg>
        <svg viewBox="0 0 14 14" fill="none">
          <path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.8" />
        </svg>
      </span>
    </a>
  ) : (
    <button type={type} class:list={classes} {...(rest as Record<string, unknown>)}>
      <span class="truncate">
        <slot />
      </span>
      <span class="btn-icon" aria-hidden="true">
        <svg viewBox="0 0 14 14" fill="none">
          <path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.8" />
        </svg>
        <svg viewBox="0 0 14 14" fill="none">
          <path d="M3 11 11 3M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.8" />
        </svg>
      </span>
    </button>
  )
}
