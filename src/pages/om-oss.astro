---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Team from '../components/Team.astro';
import Booking from '../components/Booking.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Om oss – Sandside Software Solutions UF"
  description="Lär känna de fem personerna bakom Sandside UF och varför vi bygger chatbotar för företags hemsidor."
>
  <Header />
  <main>
    <section class="cut-br bg-sand pb-24 pt-28 [--cut:48px] md:pb-32 md:pt-40 md:[--cut:96px]">
      <div class="wrap grid gap-10 md:grid-cols-12 md:items-end">
        <div class="md:col-span-7">
          <p class="label label-line" data-scramble>/ Om Sandside</p>
          <h1 class="display mt-1 text-[48px] sm:text-6xl lg:text-[84px]">Vi bygger chatbotar som gör kundfrågor enklare</h1>
        </div>
        <div class="space-y-5 text-[17px] leading-relaxed text-ink/75 md:col-span-5 md:pb-2" data-reveal>
          <p>
            Sandside UF drivs av fem elever i Göteborg inom Ung Företagsamhet. Vi startade företaget för att hjälpa
            småföretag med sådant som tar onödig tid i vardagen.
          </p>
          <p>
            Därför bygger vi chatbotar för företags hemsidor. De kan svara på återkommande frågor om öppettider,
            tjänster och bokning, så att besökaren får hjälp direkt och företaget får mer tid till sitt arbete.
          </p>
        </div>
      </div>
    </section>
    <Team />
    <Booking />
  </main>
  <Footer />
</Base>
