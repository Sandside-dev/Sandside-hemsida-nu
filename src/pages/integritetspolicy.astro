---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Base title="Integritetspolicy – Sandside">
  <Header />
  <main class="wrap max-w-[760px] pb-24 pt-32">
    <p class="label label-line">/ Integritetspolicy</p>
    <h1 class="display mt-1 text-[44px] sm:text-6xl">Integritetspolicy</h1>
    <!-- ÄNDRA: den här sidan måste skrivas innan lansering. -->
    <p class="mt-8 text-[17px] leading-relaxed text-ink/75">
      Den här sidan uppdateras inom kort. Har du frågor om hur vi hanterar personuppgifter, mejla
      <a href={`mailto:${site.email}`} class="underline underline-offset-4">{site.email}</a>.
    </p>
  </main>
  <Footer />
</Base>
